    <script>
      /* ---------------- Framework engine ---------------- */
      (function () {
        const groups = [
          ["Start here", ["s00"]],
          ["The tools", ["s01"]],
          ["The language", ["s02", "s03", "s04", "s05"]],
          ["Making choices", ["s06", "s07", "s08"]],
          ["Wrap up", ["s09"]],
        ];
        const nav = document.getElementById("nav");
        let html = "";
        groups.forEach(([title, ids]) => {
          html += `<div class="navgroup">${title}</div>`;
          ids.forEach((id) => {
            const sec = document.getElementById(id);
            const n = id.replace("s", "");
            const label = sec.getAttribute("data-nav");
            html += `<div class="navlink" data-target="${id}"><span class="n">${n}</span>${label}</div>`;
          });
        });
        nav.innerHTML = html;

        const links = [...nav.querySelectorAll(".navlink")];
        const sidebar = document.getElementById("sidebar");
        const scrim = document.getElementById("scrim");
        function closeMenu() {
          sidebar.classList.remove("open");
          scrim.classList.remove("show");
        }
        links.forEach((l) =>
          l.addEventListener("click", () => {
            document
              .getElementById(l.dataset.target)
              .scrollIntoView({ behavior: "smooth", block: "start" });
            closeMenu();
          }),
        );
        document.getElementById("menu").addEventListener("click", () => {
          sidebar.classList.toggle("open");
          scrim.classList.toggle("show");
        });
        scrim.addEventListener("click", closeMenu);
        const byId = {};
        links.forEach((l) => (byId[l.dataset.target] = l));
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                links.forEach((x) => x.classList.remove("active"));
                if (byId[e.target.id])
                  byId[e.target.id].classList.add("active");
              }
            });
          },
          { rootMargin: "-45% 0px -50% 0px", threshold: 0 },
        );
        document.querySelectorAll(".section").forEach((s) => obs.observe(s));
      })();

      /* ---------------- s01: DevTools inspector ---------------- */
      (function () {
        const mini = document.getElementById("dv-mini");
        const badge = document.getElementById("dv-badge");
        const list = document.getElementById("dv-codelist");
        const note = document.getElementById("dv-note");
        const map = [
          ["nav", '&lt;nav class="navbar"&gt;', "nav.navbar"],
          ["brand", '  &lt;a class="brand"&gt;ZS One&lt;/a&gt;', "a.brand"],
          ["link", "  &lt;a&gt;Games&lt;/a&gt;", "a"],
          [
            "button",
            '  &lt;button class="cta"&gt;Play Now&lt;/button&gt;',
            "button.cta",
          ],
          ["body", "&lt;main&gt; page content &lt;/main&gt;", "main"],
        ];
        const sel = {};
        map.forEach(([el, , s]) => (sel[el] = s));
        list.innerHTML = map
          .map(
            ([el, code]) =>
              `<div class="codeline" data-el="${el}"><span class="tag">${code}</span></div>`,
          )
          .join("");
        function clear() {
          mini
            .querySelectorAll(".inspect-hl")
            .forEach((n) => n.classList.remove("inspect-hl"));
          list
            .querySelectorAll(".lit")
            .forEach((n) => n.classList.remove("lit"));
          badge.style.opacity = "0";
          note.textContent = "Hover a line of code, or a part of the page.";
        }
        function highlight(el) {
          clear();
          const node = mini.querySelector(`[data-el="${el}"]`);
          const line = list.querySelector(`.codeline[data-el="${el}"]`);
          if (node) {
            node.classList.add("inspect-hl");
            const r = node.getBoundingClientRect(),
              mr = mini.getBoundingClientRect();
            badge.textContent = sel[el];
            badge.style.left = Math.max(2, r.left - mr.left) + "px";
            let top = r.top - mr.top - 18;
            if (top < 2) top = r.top - mr.top + 4;
            badge.style.top = top + "px";
            badge.style.opacity = "1";
          }
          if (line) line.classList.add("lit");
          note.innerHTML =
            "In DevTools this row is selected as <b>" +
            sel[el] +
            "</b> — the Styles panel would list its CSS.";
        }
        list.querySelectorAll(".codeline").forEach((line) => {
          line.addEventListener("mouseenter", () => highlight(line.dataset.el));
          line.addEventListener("mouseleave", clear);
        });
        mini.querySelectorAll("[data-el]").forEach((node) => {
          node.addEventListener("mouseenter", (e) => {
            e.stopPropagation();
            highlight(node.dataset.el);
          });
          node.addEventListener("mouseleave", clear);
        });
      })();

      /* ---------------- s02: Element quiz ---------------- */
      (function () {
