            answer: "a",
            why: "Coloured, clickable text that takes you to another page is a link.",
          },
          {
            render:
              '<button style="background:#1D3E60;color:#fff;border:none;border-radius:7px;padding:9px 16px;font-weight:600">Play Now</button>',
            answer: "button",
            why: "A control that performs an action (not navigation) is a button.",
          },
          {
            render:
              '<div style="display:flex;gap:10px;color:#2B3644;font-size:14px"><span>Games</span><span>Studio</span><span>News</span></div>',
            answer: "ul",
            why: "A repeated set of links is marked up as a list — ul with li items.",
          },
          {
            render:
              '<div style="font-weight:800;font-size:22px;color:#16273D">ZS One</div>',
            answer: "nav",
            why: "The whole bar that holds the brand and links is wrapped in a nav.",
          },
          {
            render:
              '<div style="font-weight:800;font-size:26px;color:#16273D">Read the docs</div>',
            answer: "h1",
            why: "Large, bold, top-of-page text is a heading.",
          },
        ];
        const choices = ["a", "button", "ul", "nav", "h1"];
        function load() {
          answered = false;
          fb.textContent = "";
          current = items[Math.floor(Math.random() * items.length)];
          elBox.innerHTML = current.render;
          opts.innerHTML = "";
          choices.forEach((c) => {
            const b = document.createElement("button");
            b.className = "opt";
            b.textContent = "<" + c + ">";
            b.addEventListener("click", () => pick(b, c));
            opts.appendChild(b);
          });
        }
        function pick(btn, choice) {
          if (answered) return;
          answered = true;
          asked++;
          if (choice === current.answer) {
            score++;
            btn.classList.add("right");
            fb.textContent = "Correct. " + current.why;
          } else {
            btn.classList.add("wrong");
            [...opts.children]
              .find((o) => o.textContent === "<" + current.answer + ">")
              .classList.add("right");
            fb.textContent = "Not quite. " + current.why;
          }
          scoreEl.textContent = `Score ${score} / ${asked}`;
        }
        next.addEventListener("click", load);
        load();
      })();

      /* ---------------- s03: Box model ---------------- */
      (function () {
        const w = document.getElementById("bm-w"),
          p = document.getElementById("bm-p"),
          b = document.getElementById("bm-b"),
          m = document.getElementById("bm-m");
        const marginEl = document.getElementById("bm-margin"),
          borderEl = document.getElementById("bm-border"),
          contentEl = document.getElementById("bm-content");
        const out = document.getElementById("bm-out"),
          total = document.getElementById("bm-total");
        function apply() {
          const W = +w.value,
            P = +p.value,
            B = +b.value,
            M = +m.value;
          marginEl.style.padding = M + "px";
          borderEl.style.borderWidth = B + "px";
          borderEl.style.padding = P + "px";
          contentEl.style.width = W + "px";
          document.getElementById("bm-w-v").textContent = W + "px";
          document.getElementById("bm-p-v").textContent = P + "px";
          document.getElementById("bm-b-v").textContent = B + "px";
          document.getElementById("bm-m-v").textContent = M + "px";
          out.textContent = `.box {\n  width: ${W}px;\n  padding: ${P}px;\n  border: ${B}px solid #1D3E60;\n  margin: ${M}px;\n}`;
          const totalW = W + 2 * P + 2 * B + 2 * M;
          total.innerHTML =
            "Total footprint: <b>" +
            totalW +
            "px</b> wide  (" +
            W +
            " + " +
            P +
            "×2 + " +
            B +
            "×2 + " +
            M +
            "×2).";
        }
        [w, p, b, m].forEach((el) => el.addEventListener("input", apply));
        apply();
      })();

      /* ---------------- s04: Flexbox ---------------- */
      (function () {
        const box = document.getElementById("fx-box");
        const gap = document.getElementById("fx-gap");
        const out = document.getElementById("fx-out");
        const btns = [...document.querySelectorAll("[data-jc]")];
        let jc = "flex-start";
        function apply() {
          box.style.justifyContent = jc;
          box.style.gap = gap.value + "px";
          document.getElementById("fx-gap-v").textContent = gap.value + "px";
          btns.forEach((b) => b.classList.toggle("on", b.dataset.jc === jc));
          out.textContent = `.navbar {\n  display: flex;\n  justify-content: ${jc};\n  gap: ${gap.value}px;\n}`;
        }
        btns.forEach((b) =>
          b.addEventListener("click", () => {
            jc = b.dataset.jc;
            apply();
          }),
        );
        gap.addEventListener("input", apply);
        apply();
      })();

      /* ---------------- s05: Selector matcher ---------------- */
      (function () {
        const stage = document.getElementById("sel-stage");
        const out = document.getElementById("sel-out");
        const note = document.getElementById("sel-note");
        const btns = [...document.querySelectorAll("[data-sel]")];
        const explain = {
          a: "Type selector: every <a> element, wherever it is.",
          ".cta": 'Class selector: only elements carrying class="cta".',
          "nav a": "Descendant selector: <a> elements that sit inside a <nav>.",
          button: "Type selector: every <button> element.",
        };
        function apply(selector) {
          stage
            .querySelectorAll(".sel-hit")
            .forEach((n) => n.classList.remove("sel-hit"));
          let hits = [];
          try {
            hits = [...stage.querySelectorAll(selector)];
          } catch (e) {
            hits = [];
          }
          hits.forEach((n) => n.classList.add("sel-hit"));
          out.textContent = `${selector} {\n  /* styles apply here */\n}`;
          note.innerHTML =
            "<b>" +
            hits.length +
            " element" +
            (hits.length === 1 ? "" : "s") +
            " matched.</b> " +
            (explain[selector] || "");
          btns.forEach((b) =>
            b.classList.toggle("on", b.dataset.sel === selector),
          );
        }
        btns.forEach((b) =>
          b.addEventListener("click", () => apply(b.dataset.sel)),
        );
        apply("a");
      })();

      /* ---------------- s06: Contrast checker ---------------- */
      (function () {
        const bgWrap = document.getElementById("ct-bg");
        const fgWrap = document.getElementById("ct-fg");
        const sample = document.getElementById("ct-sample");
        const verdict = document.getElementById("ct-verdict");
        const out = document.getElementById("ct-out");
        const bgs = ["#1D3E60", "#D23B36", "#16273D", "#FFFFFF", "#F3F4F7"];
        const fgs = ["#FFFFFF", "#16273D", "#D23B36", "#1D3E60"];
        let bg = bgs[0],
          fg = fgs[0];
        function lum(hex) {
          const c = hex.replace("#", "");
          const r = parseInt(c.substr(0, 2), 16) / 255,
            g = parseInt(c.substr(2, 2), 16) / 255,
            b = parseInt(c.substr(4, 2), 16) / 255;
          const f = (x) =>
            x <= 0.03928 ? x / 12.92 : Math.pow((x + 0.055) / 1.055, 2.4);
          return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
        }
        function ratio(a, b) {
          const L1 = lum(a),
            L2 = lum(b);
          const hi = Math.max(L1, L2),
            lo = Math.min(L1, L2);
          return (hi + 0.05) / (lo + 0.05);
        }
        function build(wrap, list, pick) {
          list.forEach((c, i) => {
            const d = document.createElement("div");
            d.className = "swatch" + (i === 0 ? " sel" : "");
            d.style.background = c;
            if (c === "#FFFFFF") d.style.borderColor = "#c9ced6";
            d.addEventListener("click", () => {
              pick(c);
              [...wrap.children].forEach((x) => x.classList.remove("sel"));
              d.classList.add("sel");
              apply();
            });
            wrap.appendChild(d);
          });
        }
        function apply() {
          sample.style.background = bg;
          sample.style.color = fg;
          const r = ratio(bg, fg);
          const pass = r >= 4.5;
          verdict.innerHTML =
            "Contrast <b>" +
            r.toFixed(2) +
            ":1</b> — " +
            (pass
              ? '<span style="color:#22603F">passes AA</span>'
              : '<span style="color:#B5332E">fails AA (hard to read)</span>');
          out.textContent = `background: ${bg};\ncolor: ${fg};\n/* ratio ${r.toFixed(2)}:1 */`;
        }
        build(bgWrap, bgs, (c) => (bg = c));
        build(fgWrap, fgs, (c) => (fg = c));
        apply();
      })();

      /* ---------------- s07: Hover state builder ---------------- */
      (function () {
        const demo = document.getElementById("hv-demo");
        const code = document.getElementById("hv-code");
        const dur = document.getElementById("hv-dur");
        const btns = [...document.querySelectorAll("[data-hv]")];
        let fx = "color";
        const rules = {
          color: "  color: #D23B36;",
          underline: "  border-bottom: 2px solid #D23B36;",
          bg: "  background: #1D3E60;\n  color: #ffffff;",
        };
        function apply() {
          demo.className = "nl-demo fx-" + fx;
          demo.style.transitionDuration = dur.value + "ms";
          document.getElementById("hv-dur-v").textContent = dur.value + "ms";
          btns.forEach((b) => b.classList.toggle("on", b.dataset.hv === fx));
          code.textContent = `.link {\n  transition: all ${dur.value}ms ease;\n}\n.link:hover {\n${rules[fx]}\n}`;
        }
        btns.forEach((b) =>
          b.addEventListener("click", () => {
            fx = b.dataset.hv;
            apply();
          }),
        );
        dur.addEventListener("input", apply);
        apply();
      })();
    </script>
  </body>
</html>
