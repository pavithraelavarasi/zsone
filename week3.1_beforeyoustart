<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Before You Start — Navbar Prerequisites</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f6f8fa;
        --panel: #ffffff;
        --ink: #16273d;
        --text: #2b3644;
        --muted: #79838f;
        --line: #e4e7eb;
        --line-2: #d2d7de;
        --accent: #d23b36;
        --accent-deep: #1d3e60;
        --tint: #eaf0f7;
        --blue: #215c9c;
        --red-deep: #b5332e;
        --navy-deep: #15324f;
        --hl: #215c9c;
        --hl-fill: rgba(33, 92, 156, 0.1);
        --sans: "Inter", system-ui, -apple-system, sans-serif;
        --mono: "JetBrains Mono", ui-monospace, monospace;
        --sb: 280px;
        --nav-h: 60px;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        font-family: var(--sans);
        color: var(--text);
        background: var(--bg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      h1,
      h2,
      h3 {
        color: var(--ink);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.05;
      }

      /* Sidebar */
      .sidebar {
        position: fixed;
        top: var(--nav-h);
        left: 0;
        bottom: 0;
        width: var(--sb);
        background: var(--panel);
        border-right: 1px solid var(--line);
        padding: 30px 0;
        overflow-y: auto;
        z-index: 60;
        transition: transform 0.25s ease;
      }
      .brand {
        padding: 0 28px 24px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 22px;
      }
      .brand .kicker {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.18em;
        color: var(--accent);
        margin: 0 0 12px;
      }
      .brand h1 {
        font-size: 24px;
        margin: 0 0 8px;
        letter-spacing: -0.025em;
      }
      .brand p {
        font-size: 13.5px;
        color: var(--muted);
        margin: 0;
        line-height: 1.45;
      }
      nav {
        padding: 0 16px;
      }
      .navgroup {
        font-family: var(--mono);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 0.16em;
        color: var(--muted);
        padding: 18px 12px 8px;
        text-transform: uppercase;
      }
      .navlink {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--text);
        font-size: 14.5px;
        font-weight: 500;
        cursor: pointer;
        transition:
          background 0.12s,
          color 0.12s;
      }
      .navlink .n {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--muted);
        min-width: 18px;
      }
      .navlink:hover {
        background: #f1f3f6;
      }
      .navlink.active {
        background: var(--tint);
        color: var(--accent-deep);
        font-weight: 600;
      }
      .navlink.active .n {
        color: var(--accent-deep);
      }

      /* Top nav bar */
      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--nav-h);
        z-index: 70;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 0 22px;
        background: var(--accent-deep);
        border-bottom: 3px solid var(--accent);
      }
      .nav-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }
      .nav-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        min-width: 0;
      }
      .logo-slot {
        display: grid;
        place-items: center;
        background: #fff;
        border-radius: 9px;
        width: 40px;
        height: 40px;
        padding: 6px;
        flex: none;
      }
      .logo-img {
        max-width: 100%;
        max-height: 100%;
        display: block;
      }
      .nav-title {
        color: #fff;
        font-weight: 800;
        font-size: 17px;
        letter-spacing: -0.01em;
        white-space: nowrap;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .nav-pill {
        background: var(--accent);
        color: #fff;
        font-weight: 600;
        font-size: 14px;
        padding: 8px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s;
      }
      .nav-pill:hover {
        background: var(--red-deep);
      }
      .nav-link {
        color: rgba(255, 255, 255, 0.72);
        font-weight: 500;
        font-size: 14px;
        text-decoration: none;
        padding: 8px 10px;
        transition: color 0.15s;
      }
      .nav-link:hover {
        color: #fff;
      }
      .menu {
        display: none;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: transparent;
        border-radius: 8px;
        width: 38px;
        height: 38px;
        cursor: pointer;
        place-items: center;
        padding: 0;
      }
      .menu span,
      .menu span::before,
      .menu span::after {
        content: "";
        display: block;
        width: 16px;
        height: 2px;
        background: #fff;
        position: relative;
      }
      .menu span::before {
        position: absolute;
        top: -5px;
      }
      .menu span::after {
        position: absolute;
        top: 5px;
      }
      .scrim {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(12, 19, 32, 0.35);
        z-index: 55;
      }

      /* Main */
      main {
        margin-left: var(--sb);
        padding-top: var(--nav-h);
      }
      .col {
        max-width: 880px;
        padding: 64px 56px 120px;
      }
      .eyebrow {
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.16em;
        color: var(--accent);
        text-transform: uppercase;
        margin: 0 0 22px;
      }
      .hero h2 {
        font-size: clamp(40px, 6vw, 68px);
        margin: 0 0 26px;
        letter-spacing: -0.03em;
      }
      .lede {
        font-size: 19px;
        color: var(--text);
        max-width: 60ch;
        margin: 0 0 14px;
      }
      .section {
        padding-top: 64px;
        margin-top: 48px;
        border-top: 1px solid var(--line);
        scroll-margin-top: calc(var(--nav-h) + 14px);
      }
      .section:first-of-type {
        border-top: none;
        margin-top: 0;
      }
      .part-badge {
        display: inline-flex;
        align-items: center;
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 500;
        color: var(--blue);
        border: 1px solid var(--line-2);
        border-radius: 7px;
        padding: 5px 12px;
        margin-bottom: 14px;
      }
      .section h3 {
        font-size: clamp(26px, 3.6vw, 36px);
        margin: 0 0 18px;
      }
      .section p {
        font-size: 16px;
        margin: 0 0 16px;
        max-width: 64ch;
      }
      .section p code,
      .inlinecode {
        font-family: var(--mono);
        font-size: 0.86em;
        background: #eef0f3;
        color: var(--accent-deep);
        padding: 2px 6px;
        border-radius: 5px;
      }

      /* Callout */
      .callout {
        background: var(--tint);
        border-radius: 12px;
        padding: 18px 22px;
        margin: 22px 0;
        font-size: 15px;
        color: var(--accent-deep);
        max-width: 70ch;
      }
      .callout b {
        color: var(--accent-deep);
      }

      /* Playground */
      .pg {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        margin: 26px 0;
        overflow: hidden;
      }
      .pg-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 18px;
        border-bottom: 1px solid var(--line);
      }
      .pg-head .label {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .pg-head .dot {
        width: 8px;
        height: 8px;
        border-radius: 99px;
        background: var(--blue);
        flex: none;
      }
      .pg-body {
        padding: 20px 18px;
      }
      .pg-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 14px 18px;
        border-top: 1px solid var(--line);
        background: #fafbfc;
      }
      .pg-out {
        font-family: var(--mono);
        font-size: 14px;
        color: var(--text);
      }
      .pg-out b {
        color: var(--ink);
      }

      /* Buttons */
      .btn {
        font-family: var(--sans);
        font-weight: 600;
        font-size: 14px;
        background: var(--accent-deep);
        color: #fff;
        border: none;
        border-radius: 9px;
        padding: 11px 18px;
        cursor: pointer;
        transition:
          background 0.15s,
          transform 0.05s;
      }
      .btn:hover {
        background: var(--navy-deep);
      }
      .btn:active {
        transform: translateY(1px);
      }
      .btn.ghost {
        background: var(--panel);
        color: var(--ink);
        border: 1px solid var(--line-2);
      }
      .btn.ghost:hover {
        background: #f1f3f6;
      }
      .btn.ghost.on {
        background: var(--tint);
        border-color: var(--accent-deep);
        color: var(--accent-deep);
      }
      .btnrow {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
      }

      /* Chips */
      .chip {
        font-family: var(--mono);
        font-size: 14px;
        color: var(--ink);
        background: var(--panel);
        border: 1px solid var(--line-2);
        border-radius: 9px;
        padding: 12px 16px;
        display: inline-flex;
      }
      .chiprow {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .plus {
        font-family: var(--mono);
        color: var(--muted);
        font-size: 16px;
      }

      /* Code */
      .code {
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.7;
        background: #f7f8fa;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 14px 16px;
        color: #27313f;
        white-space: pre;
        overflow-x: auto;
        margin: 0;
      }
      .code .tag {
        color: #1d3e60;
      }
      .code .c {
        color: #94a0ae;
      }
      .code .str {
        color: #1b7f5b;
      }
      .code .cut {
        color: #b5332e;
      }
      .code .keep {
        color: #22603f;
      }

      /* Preview frames */
      .preview {
        width: 100%;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        min-height: 120px;
      }
      .twocol {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      @media (max-width: 760px) {
        .twocol {
          grid-template-columns: 1fr;
        }
      }

      /* Controls */
      .ctrl {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 10px 0;
        font-size: 14px;
      }
      .ctrl label {
        min-width: 120px;
        color: var(--text);
        font-weight: 500;
      }
      input[type="range"] {
        flex: 1;
        accent-color: var(--accent-deep);
      }
      .swatches {
        display: flex;
        gap: 8px;
      }
      .swatch {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        border: 1px solid var(--line-2);
        cursor: pointer;
      }
      .swatch.sel {
        outline: 2px solid var(--accent-deep);
        outline-offset: 2px;
      }
      .val {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--muted);
        min-width: 52px;
        text-align: right;
      }

      /* Inspector */
      .inspect-wrap {
        position: relative;
      }
      .mini {
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        position: relative;
      }
      .mini * {
        transition: outline 0.1s;
      }
      .inspect-hl {
        outline: 2px solid var(--hl) !important;
        outline-offset: 1px;
        background: var(--hl-fill);
      }
      .inspect-badge {
        position: absolute;
        z-index: 5;
        font-family: var(--mono);
        font-size: 11px;
        color: #fff;
        background: var(--hl);
        padding: 2px 7px;
        border-radius: 5px;
        pointer-events: none;
        opacity: 0;
        transform: translateY(2px);
        transition: opacity 0.1s;
        white-space: nowrap;
      }
      .codelist {
        font-family: var(--mono);
        font-size: 12.5px;
        line-height: 1.9;
        background: #f7f8fa;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 12px 8px;
        overflow-x: auto;
      }
      .codeline {
        padding: 1px 8px;
        border-radius: 5px;
        cursor: default;
        white-space: pre;
        color: #27313f;
      }
      .codeline:hover,
      .codeline.lit {
        background: var(--hl-fill);
        box-shadow: inset 2px 0 0 var(--hl);
      }
      .codeline .tag {
        color: #1d3e60;
      }

      /* Quiz */
      .quiz-el {
        border: 1px dashed var(--line-2);
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 14px;
        display: grid;
        place-items: center;
        min-height: 84px;
        background: #fbfcfd;
      }
      .quiz-opts {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }
      @media (max-width: 520px) {
        .quiz-opts {
          grid-template-columns: 1fr;
        }
      }
      .opt {
        font-family: var(--mono);
        font-size: 14px;
        border: 1px solid var(--line-2);
        background: #fff;
        border-radius: 9px;
        padding: 12px;
        cursor: pointer;
        transition: 0.12s;
      }
      .opt:hover {
        border-color: var(--accent);
      }
      .opt.right {
        background: #e7f3ec;
        border-color: #3e9b68;
        color: #22603f;
      }
      .opt.wrong {
        background: #fbebea;
        border-color: #cf6f66;
        color: #8c322a;
      }
      .quiz-feedback {
        font-size: 14px;
        margin-top: 12px;
        min-height: 20px;
        color: var(--text);
      }
      .score {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--muted);
      }

      footer {
        margin-top: 64px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        font-size: 13px;
        color: var(--muted);
      }

      @media (max-width: 880px) {
        .sidebar {
          transform: translateX(-100%);
        }
        .sidebar.open {
          transform: none;
          box-shadow: 0 0 40px rgba(12, 19, 32, 0.18);
        }
        .menu {
          display: grid;
        }
        main {
          margin-left: 0;
        }
        .col {
          padding: 34px 22px 90px;
        }
        .scrim.show {
          display: block;
        }
      }
      @media (max-width: 520px) {
        .nav-title {
          display: none;
        }
        .nav-link {
          display: none;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
          scroll-behavior: auto;
        }
      }

      /* ---------------- Bespoke prerequisite-playground styles ---------------- */
      .nl-demo {
        font-family: var(--sans);
        font-weight: 600;
        font-size: 15px;
        color: var(--accent-deep);
        text-decoration: none;
        padding: 8px 6px;
        border-bottom: 2px solid transparent;
        cursor: pointer;
        transition: all 0.18s;
      }
      .nl-demo.fx-color:hover {
        color: var(--accent);
      }
      .nl-demo.fx-underline:hover {
        border-bottom-color: var(--accent);
      }
      .nl-demo.fx-bg:hover {
        background: var(--accent-deep);
        color: #fff;
        border-radius: 8px;
        border-bottom-color: transparent;
      }
      .sel-hit {
        outline: 2px solid var(--hl) !important;
        outline-offset: 2px;
        background: var(--hl-fill);
      }
      .bm-wrap {
        overflow-x: auto;
        display: flex;
        justify-content: center;
        padding: 6px 0;
      }
    </style>
  </head>
  <body>
    <aside class="sidebar" id="sidebar">
      <div class="brand">
        <p class="kicker">NAVBAR PREREQUISITES</p>
        <h1>Before You Start</h1>
        <p>The tools and language the navbar brief assumes you already know.</p>
      </div>
      <nav id="nav"></nav>
    </aside>

    <div class="scrim" id="scrim"></div>

    <header class="navbar">
      <div class="nav-left">
        <button class="menu" id="menu" aria-label="Open navigation">
          <span></span>
        </button>
        <a class="nav-brand" href="#s00">
          <span class="logo-slot"
            ><img
              id="site-logo"
              class="logo-img"
              src="logo.png"
              alt="ZS One logo"
          /></span>
          <span class="nav-title">ZS One</span>
        </a>
      </div>
      <nav class="nav-links">
        <a class="nav-pill" href="#s00">Overview</a>
        <a class="nav-link" href="#s09">Wrap up</a>
      </nav>
    </header>

    <main>
      <div class="col">
        <!-- ===================== s00 HERO ===================== -->
        <section class="section hero" id="s00" data-nav="Overview">
          <p class="eyebrow">What the brief doesn't tell you</p>
          <h2>The skills the assignment assumes you have.</h2>
          <p class="lede">
            The brief tells you what to do — inspect navbars, plan, write a
            spec, build, add a hover effect. It never teaches the tools and the
            language you need to actually do any of it.
          </p>
          <p class="lede">
            This page fills those gaps: how to drive DevTools, the handful of
            HTML elements a navbar is made of, the box model, flexbox, CSS
            selectors, colour contrast, and how <code>:hover</code> really
            works. Each one is a playground you can touch.
          </p>

          <div class="callout">
            <b>How to use this page.</b> Do this before you build. Every section
            is a skill the brief leans on but skips — get these into your hands
            and the assignment becomes mechanical.
          </div>
        </section>

        <!-- ===================== s01 DEVTOOLS ===================== -->
        <section class="section" id="s01" data-nav="DevTools">
          <span class="part-badge">Part 01</span>
          <h3>How to actually use DevTools</h3>
          <p>
            The brief says "use DevTools to inspect the navbar" — but not how.
            Open it with <code>Cmd/Ctrl + Shift + C</code> (or right-click any
            element and choose <i>Inspect</i>). The <b>Elements</b> panel shows
            the HTML tree; the <b>Styles</b> panel next to it shows the CSS
            hitting the selected element.
          </p>
          <p>
            The core move: hover a line of HTML and the matching pixels light up
            on the page — and back. Try it below.
          </p>

          <div class="pg">
            <div class="pg-head">
              <span class="dot"></span
              ><span class="label">Playground · Inspect like DevTools</span>
            </div>
            <div class="pg-body twocol">
              <div class="inspect-wrap">
                <div class="mini" id="dv-mini">
                  <div class="inspect-badge" id="dv-badge"></div>
                  <div
                    data-el="nav"
                    style="
                      display: flex;
                      align-items: center;
                      justify-content: space-between;
                      background: var(--accent-deep);
                      padding: 14px 16px;
                    "
                  >
                    <span
                      data-el="brand"
                      style="color: #fff; font-weight: 800; font-size: 15px"
                      >ZS One</span
                    >
                    <span style="display: flex; align-items: center; gap: 12px">
                      <span
                        data-el="link"
                        style="
                          color: rgba(255, 255, 255, 0.82);
                          font-size: 13px;
                        "
                        >Games</span
                      >
                      <span
                        data-el="button"
                        style="
                          background: var(--accent);
                          color: #fff;
                          font-size: 13px;
                          font-weight: 600;
                          padding: 7px 14px;
                          border-radius: 7px;
                        "
                        >Play Now</span
                      >
                    </span>
                  </div>
                  <div
                    data-el="body"
                    style="
                      padding: 22px 16px;
                      color: var(--muted);
                      font-family: var(--mono);
                      font-size: 12px;
                    "
                  >
                    page content…
                  </div>
                </div>
              </div>
              <div><div class="codelist" id="dv-codelist"></div></div>
            </div>
            <div class="pg-foot">
              <span class="pg-out" id="dv-note"
                >Hover a line of code, or a part of the page.</span
              >
            </div>
          </div>

          <div class="callout">
            <b>Do not edit the real site.</b> Changes you type in DevTools are
            temporary — they vanish on refresh. It is a lens for reading, not
            your editor.
          </div>
        </section>

        <!-- ===================== s02 ELEMENTS ===================== -->
        <section class="section" id="s02" data-nav="Elements">
          <span class="part-badge">Part 02</span>
