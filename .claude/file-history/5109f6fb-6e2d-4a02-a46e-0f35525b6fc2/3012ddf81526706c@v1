	public Long getProjectGidByName(long zuID, String workspaceGid, String projectName, String loginName, long apid) {

		LOGGER.log(Level.INFO, "Getting project GID for project name: {0}", projectName);
		List<JSONObject> projects = getAllProjects(zuID, workspaceGid, loginName, apid);

        for (JSONObject project : projects) {
            if (!project.has("name") || !project.has("gid")) {
                continue;
            }

            String name = project.getString("name");

            if (name.equalsIgnoreCase(projectName)) {
                try {
                    return Long.parseLong(project.getString("gid"));
                } catch (NumberFormatException e) {
					LOGGER.log(Level.SEVERE, "Could not parse GID to Long: {0}", project.getString("gid"));
                    return null;
                }
            }
        }
        return null;
    }

	public JSONObject addAsanaTask(long zuID, String workspaceGid, String projectGid, String taskName, String taskdescription, String assigneeGid, String loginName, long apid) {
		LOGGER.log(Level.INFO, "Adding task in Asana");

		String accessToken = getAccessToken(zuID, loginName, apid);
		if (accessToken == null) {
			LOGGER.log(Level.SEVERE, "Access token not found");
			return null;
		}

		String url = ASANABASEURL + "api/1.0/tasks"; // no i18N

		Map<String, String> headers = new HashMap<>();
		headers.put("Authorization", "Bearer " + accessToken);
        headers.put("Content-Type", "application/json");

		try {
			// Asana requires JSON body with "data" wrapper
			JSONObject data = new JSONObject();
			data.put("name", taskName);
			data.put("workspace", workspaceGid);

			if (!CommonUtil.isEmpty(projectGid)) {
				JSONArray projects = new JSONArray();
				projects.put(projectGid);
				data.put("projects", projects);
			}
			if (!CommonUtil.isEmpty(taskdescription)) {
				data.put("notes", taskdescription);
			}
			if (!CommonUtil.isEmpty(assigneeGid)) {
				data.put("assignee", assigneeGid);
            }

			JSONObject body = new JSONObject();
			body.put("data", data);

			LOGGER.log(Level.INFO, "Asana create task request body: {0}", body.toString());

			// Send as JSON body not form params
			JSONObject result = new HttpURLConnectionInvoker(true).invokeHttpURLConn(1, url, headers, body, null, false); // 1 = POST

			LOGGER.log(Level.INFO, "Asana create task response: {0}", result);
			return result;

		} catch (Exception e) {
			LOGGER.info("Exception while adding task in Asana: " + e);
        }
		return null;
    }

	// helper method
	private JSONObject invokeAsanaAPI(String method, String url, String accessToken, JSONObject body) {
		try {
			java.net.URL urlObj = new java.net.URL(url);
			javax.net.ssl.HttpsURLConnection conn = (javax.net.ssl.HttpsURLConnection) urlObj.openConnection();

			conn.setRequestMethod(method);
			conn.setRequestProperty("Authorization", "Bearer " + accessToken);
			conn.setRequestProperty("Content-Type", "application/json");
			conn.setRequestProperty("Accept", "application/json");
			conn.setConnectTimeout(10000);
			conn.setReadTimeout(10000);

			if (body != null) {
				conn.setDoOutput(true);
				byte[] bodyBytes = body.toString().getBytes("UTF-8");
				conn.setFixedLengthStreamingMode(bodyBytes.length);
				try (java.io.OutputStream os = conn.getOutputStream()) {
					os.write(bodyBytes);
					os.flush();
				}
			}

			int responseCode = conn.getResponseCode();
			LOGGER.log(Level.INFO, "Response code: {0}", responseCode);

			java.io.InputStream is = (responseCode >= 200 && responseCode < 300) ? conn.getInputStream() : conn.getErrorStream();

			java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(is, "UTF-8"));
			StringBuilder responseStr = new StringBuilder();
			String line;
			while ((line = reader.readLine()) != null) {
				responseStr.append(line);
			}
			reader.close();
			conn.disconnect();

			LOGGER.log(Level.INFO, "Asana API response: {0}", responseStr.toString());

			if (responseCode == 200 && responseStr.toString().isEmpty()) {
				return new JSONObject("{\"result\":\"success\"}"); // no i18N
			}
			return new JSONObject(responseStr.toString());

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception in invokeAsanaAPI", e);
		}
		return null;
	}
    
	public JSONObject updateAsanaTask(long zuID, String taskGid, String taskname, String taskdescription, String assigneeGid, String approvalStatus, String loginName, long apid) {

        LOGGER.log(Level.INFO, "Updating task in Asana");

        JSONObject response = null;

        try {
			String accessToken = getAccessToken(zuID, loginName, apid);

            Map<String, String> headers = new HashMap<>();
            headers.put("Authorization", "Bearer " + accessToken);
            headers.put("Content-Type", "application/json");

			String url = ASANABASEURL + "api/1.0/tasks/" + taskGid; // no i18n

            JSONObject data = new JSONObject();

            if (!CommonUtil.isEmpty(taskname)) {
                data.put("name", taskname);
            }

            if (!CommonUtil.isEmpty(taskdescription)) {
                data.put("notes", taskdescription); // no i18N Asana uses "notes" 
            }

            if (!CommonUtil.isEmpty(assigneeGid)) {
                data.put("assignee", assigneeGid);
            }

            if (!CommonUtil.isEmpty(approvalStatus)) {
                data.put("approval_status", approvalStatus);
            }

            JSONObject body = new JSONObject();
            body.put("data", data);
			response = new HttpURLConnectionInvoker(true).invokeHttpURLConn(3, url, headers, body, null, false);
			// response = invokeAsanaAPI("PUT", url, accessToken, body);

        } catch (Exception e) {
            LOGGER.log(Level.SEVERE, "Exception while updating task in Asana", e);
        }

        return response;
    }

	public JSONObject getTask(long zuID, String taskGid, String loginName, long apid) {
		LOGGER.log(Level.INFO, "Getting task from Asana: {0}", taskGid);

		try {
			String accessToken = getAccessToken(zuID, loginName, apid);
			if (accessToken == null) {
				LOGGER.log(Level.SEVERE, "Access token not found");
				return null;
			}

			String url = ASANABASEURL + "api/1.0/tasks/" + taskGid; // no i18N

			Map<String, String> headers = new HashMap<>();
			headers.put("Authorization", "Bearer " + accessToken);
			headers.put("Content-Type", "application/json");

			String res = new HttpURLConnectionInvoker(true).invokeGetHttpURLConn(url, headers, null);

			JSONObject response = new JSONObject(res);
			if (response.has("data")) {
				return response.getJSONObject("data");
			}

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while getting task from Asana", e);
		}
		return null;
	}
