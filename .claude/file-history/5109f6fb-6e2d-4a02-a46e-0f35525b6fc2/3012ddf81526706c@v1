    // authentication - asana
	public boolean authenticate(long zuID, String code, String zsoId, String redirectUri, long projectId) {
		String url = ASANABASEURL + "-/oauth_token"; // no i18N

		String clientID = PropertyHandler.getValue(AppticsConstants.ASANACLIENTID);
		String clientSecret = PropertyHandler.getValue(AppticsConstants.ASANACLIENTSECRET);

		if (CommonUtil.isEmpty(clientID, clientSecret)) {
			LOGGER.log(Level.INFO, "Asana Client ID or Secret is empty");
			return false;
		}

		try {
			Map<String, String> params = new HashMap<String, String>();

			params.put("grant_type", "authorization_code");
			params.put("code", code);
			params.put("client_id", clientID);
			params.put("client_secret", clientSecret);
			params.put("redirect_uri", redirectUri);
			params.put("scope", ASANASCOPE);

			LOGGER.log(Level.INFO, "Params Map{0} ", params);

			// String res = new HttpURLConnectionInvoker(true).invokePostHttpURLConn(url, null, params);
			String res = new HttpURLConnectionInvoker(true).invokePostHttpURLConn(url, null, params);

			JSONObject response = new JSONObject(res);

			LOGGER.log(Level.INFO, "response JSON{0} ", response);
			LOGGER.log(Level.INFO, "-------- ACCESSTOKEN IS THERE IN RESPONSE--------");

			LOGGER.log(Level.INFO, response.toString());

			if (!response.has("access_token")) {
				LOGGER.log(Level.WARNING, "No access_token in response: {0}", res);
				return false;
			}
			String accessToken = response.getString("access_token");
			String refreshToken = response.optString("refresh_token", null); 
			addAsanaOAuth(zuID, accessToken, refreshToken, zsoId);

			LOGGER.log(Level.INFO, "Inserted ASANA Oauth into the table");
			return true;
		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while authenticating Asana", e);
		}
		return false;
	}

	private DataObject addAsanaOAuth(long zuID, String accessToken, String refreshToken, String loginName) throws Exception {
		LOGGER.log(Level.INFO, "------INSIDE THE ADD METHOD FOR ASANA INTEGRATIONS DETAILS");

		Map<String, Object> ukcolumns = new HashMap<String, Object>();
        ukcolumns.put(AppticsConstants.ZUID, zuID);
		// ukcolumns.put(AppticsConstants.REFRESHTOKEN, accessToken);
        ukcolumns.put(AppticsConstants.SERVICENAME, AppticsConstants.ASANA);
		// ukcolumns.put(AppticsConstants.ACCESSTOKEN, subDomain); // using accesstoken column to store subdomain name // want to this about asana

		 if (MickeyUtil.isRowExist(AppticsConstants.REFRESHTOKEN, AppticsConstants.REFRESHTOKENID, ukcolumns, loginName))
		 {
				LOGGER.log(Level.INFO, "Asana OAuth Details Already Exist. please Try different name.");
		 throw new AppticsException(AppticsConstants.DUPLICATEENTRY, AppticsConstants.DUPLICATEENTRY);
		 }

        Row row = new Row(AppticsConstants.REFRESHTOKEN);
		row.set(AppticsConstants.REFRESHTOKEN, refreshToken);
		row.set(AppticsConstants.ACCESSTOKEN, accessToken);
        row.set(AppticsConstants.ZUID, zuID);
        row.set(AppticsConstants.SERVICENAME, AppticsConstants.ASANA);
        row.set(AppticsConstants.ADDEDTIME, CalendarUtil.currentTimeMillis());
		// row.set(AppticsConstants.ACCESSTOKEN, subDomain);
		List<Row> rows = new ArrayList<>();
		rows.add(row);
		return DBHandler.insertRows(rows, loginName);

    }
    public String getAsanaOAuthToken(long zuID, long tokenID) throws DataAccessException {
        Criteria c = new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.REFRESHTOKENID), tokenID, QueryConstants.EQUAL);
        c = c.and(new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.ZUID), zuID, QueryConstants.EQUAL));
        c = c.and(new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.SERVICENAME), AppticsConstants.ASANA, QueryConstants.EQUAL, false));

		List<Map<String, Object>> result = DBHandler.getColumnsValues(AppticsConstants.REFRESHTOKEN, c);
		if (result != null && !result.isEmpty()) {
			Map<String, Object> row = result.get(0);
			return (String) row.get(AppticsConstants.REFRESHTOKEN);
		}
		return null;
    }

	public JSONArray getOAuthTokens(long zuid) {
		JSONArray tokens = new JSONArray();
		LOGGER.log(Level.INFO, "Inside the getoauthtoken");

		try {
			Criteria c = new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.ZUID), zuid, QueryConstants.EQUAL);
			c = c.and(new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.SERVICENAME), AppticsConstants.ASANA, QueryConstants.EQUAL, false));

			LOGGER.log(Level.INFO, "after setting criteria ,,,,");
			List<Map<String, Object>> result = DBHandler.getColumnsValues(AppticsConstants.REFRESHTOKEN, c);

			LOGGER.log(Level.INFO, "getOAuthTokens result size: {0}", new Object[] { result.size() });

			if (result == null || result.isEmpty()) {
				LOGGER.log(Level.INFO, "No Rows found match with zuid = {0}", new Object[] { zuid });
				return tokens;
			}

			for (Map<String, Object> row : result) {
				JSONObject token = new JSONObject();
				token.put("asanaid", row.get(AppticsConstants.REFRESHTOKENID));
				token.put("addedtime", row.get(AppticsConstants.ADDEDTIME));
				token.put("refreshtoken", row.get(AppticsConstants.REFRESHTOKEN));
				token.put("accesstoken", row.get(AppticsConstants.ACCESSTOKEN));
				token.put("apid", row.get(AppticsConstants.APID)); // add this line

				tokens.put(token);
			}
		} catch (DataAccessException e) {
			LOGGER.log(Level.SEVERE, "Exception while fetching current user asana OAuth Token", e);
		}
		return tokens;
	}

	// getting accesstoken - if it is expired refreshed again
	public String getAccessToken(long zuID, String loginName, long apid) {
		LOGGER.log(Level.INFO, "inside the getaccesstoken method----");
		JSONArray tokens = getOAuthTokens(zuID);
		String accessToken = null;

		for (int i = 0; i < tokens.length(); i++) {
			JSONObject obj = tokens.getJSONObject(i);
			// Just get the first Asana token for this user
			if (obj.has("accesstoken")) {
				accessToken = obj.getString("accesstoken");

				try {
					String[] parts = accessToken.split("\\.");
					if (parts.length == 3) {
						String payload = new String(java.util.Base64.getDecoder().decode(parts[1]));
						JSONObject claims = new JSONObject(payload);
						long exp = claims.getLong("exp");
						long now = System.currentTimeMillis() / 1000;

						if (now >= exp) {
							LOGGER.log(Level.WARNING, "Access token expired! Refreshing...");
							String refreshToken = obj.getString("refreshtoken");
							accessToken = refreshAccessToken(zuID, refreshToken, loginName);
						}
					}
				} catch (Exception e) {
					LOGGER.log(Level.SEVERE, "Error checking token expiry", e);
				}
				break;
			}
		}
		return accessToken;
	}

	// method for refresh the access token
	private String refreshAccessToken(long zuID, String refreshToken, String loginName) {
		LOGGER.log(Level.INFO, "Refreshing Asana access token");
		try {
			String clientID = PropertyHandler.getValue(AppticsConstants.ASANACLIENTID);
			String clientSecret = PropertyHandler.getValue(AppticsConstants.ASANACLIENTSECRET);

			Map<String, String> params = new HashMap<>();
			params.put("grant_type", "refresh_token");
			params.put("client_id", clientID);
			params.put("client_secret", clientSecret);
			params.put("refresh_token", refreshToken);

			String res = new HttpURLConnectionInvoker(true).invokePostHttpURLConn(ASANABASEURL + "-/oauth_token", null, params); // no i18N

			JSONObject response = new JSONObject(res);
			if (response.has("access_token")) {
				String newAccessToken = response.getString("access_token");
				LOGGER.log(Level.INFO, " Token refreshed successfully");

				// pass loginName
				updateAccessToken(zuID, newAccessToken, loginName);
				return newAccessToken;
			}
		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while refreshing access token", e);
		}
		return null;
	}

	private void updateAccessToken(long zuID, String newAccessToken, String loginName) {
		try {
			Criteria c = new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.ZUID), zuID, QueryConstants.EQUAL);
			c = c.and(new Criteria(Column.getColumn(AppticsConstants.REFRESHTOKEN, AppticsConstants.SERVICENAME), AppticsConstants.ASANA, QueryConstants.EQUAL, false));

			int updated = DBHandler.update(AppticsConstants.REFRESHTOKEN, c, AppticsConstants.ACCESSTOKEN, newAccessToken, loginName);
			LOGGER.log(Level.INFO, " Access token updated in DB, rows affected: {0}", updated);

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while updating access token in DB", e);
		}
	}

	// getting all the workspace id and names
	public List<JSONObject> getAllWorkspaces(long zuID, String loginName, long apid) {
        LOGGER.log(Level.INFO,"Getting all the workspace Id");
        ArrayList<JSONObject> workspaceList = new ArrayList<>();
        String url = ASANABASEURL+"api/1.0/workspaces";  //no i18N

		String accessToken = getAccessToken(zuID, loginName, apid);

        if (accessToken == null) {
            LOGGER.log(Level.SEVERE, "Access token not found");
            return workspaceList;
        }
        Map<String, String> headers = new HashMap<String, String>();
        headers.put("Authorization", "Bearer "+accessToken);
        headers.put("Content-Type", "application/json");

        Map<String,String> params = new HashMap<String,String>();
        try {
			String res = new HttpURLConnectionInvoker(true).invokeGetHttpURLConn(url, headers, null);

            JSONObject response = new JSONObject(res);
            JSONArray result = response.getJSONArray("data"); //no i18N
            for(int i =0;i< result.length();i++) {
                JSONObject workspaceIDObj = result.getJSONObject(i);
                workspaceList.add(workspaceIDObj);
            }
        }catch (Exception e) {
            LOGGER.info("Exception while adding bug in projects "+ e);
        }
        return workspaceList;
    }

