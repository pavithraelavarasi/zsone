    public void getAllWorkspaces(){
		LOGGER.log(Level.INFO, "Inside the GET ALL WORKSPACE IN ACTION CLASS");
        Long zuID = AppticsIAMUtil.getCurrentUserZUID();
        try {
            if (!validateUser() || !validateRolesAndPermissions()) {
                ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
                return;
            }
			long apid = Long.parseLong(request.getParameter("apid")); // get apid from request
			List<JSONObject> workspaces = new AsanaHandler().getAllWorkspaces(zuID, zsoid.toString(), apid);
			LOGGER.log(Level.INFO, "ALL THE WORKSPACE LIST {0}", workspaces);
            if (workspaces == null || workspaces.isEmpty()) {
                ClientWriter.sendErrorResponse(response, AppticsConstants.SDK_OTHER_EXP_STRING, "NO_WORKSPACES"); // no i18N
                return;
            }

            JSONArray jsonArr = new JSONArray();

			LOGGER.log(Level.INFO, "getting all the workspaces {0}", jsonArr);
            for (JSONObject json : workspaces) {
                jsonArr.put(json);
            }
			LOGGER.log(Level.INFO, "after the iteration of all the get workspcse");
            ClientWriter.sendResponse(response, jsonArr);

        } catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while fetching asana worksapce", e);
            ClientWriter.sendErrorResponse(response, AppticsConstants.EXCEPTION, "Exception while fetching Jira Projects");
        }
    }
    //Returns a list of asana project name and id for the configured Apptics project i:e particular workspace.
    //Requires at least dev or dev lead role
    public void getAllProjects() {
		LOGGER.log(Level.SEVERE, "Inside the get all projects method in actions");
        Long zuID = AppticsIAMUtil.getCurrentUserZUID();
		LOGGER.log(Level.SEVERE, "Inside the get all projects method in actions{0}", zuID);
		long apid = Long.parseLong(request.getParameter("apid")); // get apid from request

        try {
            if (!validateUser() || !validateRolesAndPermissions()) {
                ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
                return;
            }

			List<JSONObject> projects = new AsanaHandler().getAllProjects(zuID, workspaceGid, zsoid.toString(), apid);
            if (projects == null || projects.isEmpty()) {
                ClientWriter.sendErrorResponse(response, AppticsConstants.SDK_OTHER_EXP_STRING, "NO_PROJECTS"); // no i18N
                return;
            }

            JSONArray jsonArr = new JSONArray();
			LOGGER.log(Level.SEVERE, "GET ALL PROJECTS JSON {0}", jsonArr);
            for (JSONObject json : projects) {
                jsonArr.put(json);
            }

            ClientWriter.sendResponse(response, jsonArr);

        } catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while fetching Asana projects", e);
            ClientWriter.sendErrorResponse(response, AppticsConstants.EXCEPTION, "Exception while fetching Jira Projects");
        }
    }

