                    AppticsConstants.UNAUTHORIZED_MSG
            );
            return false;
        }
        return true;
    }


    //Returns true when current user role is DEV, DEV_LEAD or PM
    private boolean validateRolesAndPermissions() throws Exception {
        setCurrentUserRoles(projectID, zsoid);
        if (projectRole < 1) {
            ClientWriter.sendErrorResponse(
                    response,
                    AppticsConstants.PERMISSION_DENIED,
                    AppticsConstants.PERMISSION_DENIED_MSG
            );
            return false;
        }
        return true;
    }

    public void getConfiguration() {
        LOGGER.log(Level.INFO, "get configuration.");

        Long zuID = AppticsIAMUtil.getCurrentUserZUID();
        if (zuID == null) {
            ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
            return;
        }
        try {
            JSONObject configuration = new AsanaHandler().getConfiguration(apid);

            ClientWriter.sendResponse(response, CommonUtil.isEmpty(configuration) ? new JSONObject() : configuration);
        }
        catch (Exception e) {
            LOGGER.log(Level.SEVERE, "Exception while getting asana configuration ", e);
            ClientWriter.sendErrorResponse(response, AppticsConstants.EXCEPTION, "Exception while configuration, please try again later.");
        }
    }

    public void updateConfiguration() {
        try
        {

            LOGGER.log(Level.INFO, "Update asana configuration.");

            checkCurrentUserZUID();
            setCurrentUserRoles(projectID, zsoid);
            if (projectRole < 1)
            {
                ClientWriter.sendErrorResponse(response, AppticsConstants.PERMISSION_DENIED, AppticsConstants.PERMISSION_DENIED_MSG);
                return;
            }

            isParamContainsEmpty(apid);
            isValiedAppPlatform(projectID, apid);

            JSONObject configuration = new JSONObject(request.getParameter(AppticsConstants.S_CONFIGURATION));
			// configuration.put("zuid", AppticsIAMUtil.getCurrentUserZUID()); // for create task in Asana

            configuration = new AsanaHandler().updateConfiguration(apid, configuration);

            ClientWriter.sendResponse(response, CommonUtil.isEmpty(configuration) ? new JSONObject() : configuration);

            Map<String,Object> param = ApplicationLog.getParameter(mode, "asana");
            ApplicationLog.addLog(ApplicationLog.INTEGRATIONS, null, projectID, request, param, 91, apid, "asana");
            User user = checkCurrentUser();
            String projectName = ProjectHandler.getDisplayName(projectID);
            String identifier =  AppHandler.getInstance().getIdentifierByAPID(apid);
            String portalName = ServiceOrgHandler.getInstance().getServiceOrgName(zsoid);

            List<Long> roleIDs = RoleHandler.getRoleIDs(RoleHandler.getRoleNameList(RoleHandler.MANAGERLEADANDDEVS), null);
            String email = ProjectSettingsHandler.getMemberEmailsAsCSV(projectID, roleIDs, false);
			String content = EmailNotificationContent.getIntegrationConfiguredMailContent("Asana", projectName, user.getDisplayName(), identifier, portalName);
            TransmailNotificationUtil.sendMail("Integration configurations updated", content, "no-reply@zohoapptics.com", email);

        }
        catch (AppticsException e)
        {
            LOGGER.log(Level.SEVERE, AppticsConstants.EXCEPTION, e);
            e.writeToClient(response);
        }
        catch (Exception e)
        {
            LOGGER.log(Level.SEVERE, AppticsConstants.EXCEPTION, e);
            ClientWriter.sendErrorResponse(response, AppticsConstants.UNPROCESSABLE_ENTITY, AppticsConstants.UNPROCESSABLE_ENTITY_MSG, AppticsConstants.SC_EXPECTATION_FAILED);
        }

    }

    public void authenticate() {
		LOGGER.log(Level.INFO, "authenticating asana user.");

        Long zuID = AppticsIAMUtil.getCurrentUserZUID();

		if (zuID == null) {
            ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
            return;
        }
		if (CommonUtil.isEmpty(state)) {
			LOGGER.log(Level.SEVERE, "State param is null or empty");
			ClientWriter.sendErrorResponse(response, AppticsConstants.BAD_REQUEST, "Invalid state param");
			return;
		}

        String[] split = state.split(",");

		if (split.length < 4) {
			LOGGER.log(Level.SEVERE, "State param format invalid: {0}", state);
			ClientWriter.sendErrorResponse(response, AppticsConstants.BAD_REQUEST, "Invalid state format");
			return;
		}
		String zsoId = split[0]; // 49453462
		long projectID = Long.parseLong(split[1]); // 4000000002002
		// split[2] = zuId (15065957) — already from session
		LOGGER.log(Level.INFO, "ZSOID FROM AUTHENTICATE METHOD------ {0}", zsoId);
		LOGGER.log(Level.INFO, "Project ID {0}", projectID);
		if (!CommonUtil.isEmpty(error)) {
			try {
				response.sendRedirect("/ac/" + zsoId + "/" + projectID + "/" + zuID + "/settings#integrations/asana"); // no i18N
				return;
			} catch (IOException e) {
				LOGGER.log(Level.SEVERE, "User denied authentication", e);
                return;
            }
        }

		try {
			boolean status = new AsanaHandler().authenticate(zuID, code, zsoId, request.getRequestURL().toString(), projectID);
			LOGGER.log(Level.INFO, "Integration status : {0}", status);
			response.sendRedirect("/ac/" + zsoId + "/" + projectID + "/" + zuID + "/settings#integrations/asana"); // no i18N
		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while authenticating asana user", e);
        }
    }

    public void getOAuthTokens() {
        LOGGER.log(Level.INFO, "getting oauth Tokens for asana.");

        Long zuID = AppticsIAMUtil.getCurrentUserZUID();
        if(zuID == null )
        {
            ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
            return;
        }
        try
        {
			// Long zuID = AppticsIAMUtil.getCurrentUserZUID();
            JSONArray tokens = new AsanaHandler().getOAuthTokens(zuID);
            JSONObject result = new JSONObject();
            result.put("tokens", tokens);
            result.put("clientid", PropertyHandler.getValue(AppticsConstants.ASANACLIENTID));

            ClientWriter.sendResponse(response, result);
        }
        catch (Exception e)
        {
            LOGGER.log(Level.SEVERE, "Exception while getting oauth tokens ", e);
            ClientWriter.sendErrorResponse(response, AppticsConstants.EXCEPTION, "Exception while getting oauth tokens, please try again later."); //no i18N
        }
    }


    public void createTask() {

		// ExceptionHandler ex = new ExceptionHandler();
		// ex.testMethod();

		AsanaHandler handler = new AsanaHandler();
		try {
			LOGGER.log(Level.INFO, "Create asana task.");

			Long zuID = AppticsIAMUtil.getCurrentUserZUID();
			long apid = Long.parseLong(request.getParameter("apid")); // get apid from request

			if (zuID == null) {
				ClientWriter.sendErrorResponse(response, AppticsConstants.UNAUTHORIZED, AppticsConstants.UNAUTHORIZED_MSG);
				return;
			}
			if (CommonUtil.isEmpty(workspaceName, projectName, taskName)) {
				ClientWriter.sendErrorResponse(response, AppticsConstants.BAD_REQUEST, "workspaceName, projectName and taskName are required");
				return;
			}

			// Get workspaceGid from workspaceName
			String workspaceGid = handler.getWorkSpaceIDByName(zuID, workspaceName, zsoid.toString(), apid);
			if (CommonUtil.isEmpty(workspaceGid)) {
				LOGGER.log(Level.WARNING, "Workspace not found for name: {0}", workspaceName);
				ClientWriter.sendErrorResponse(response, AppticsConstants.NOT_FOUND, "Workspace Name not found in Asana");
				return;
			}

			// Get projectGid from projectName
			Long projectGidLong = handler.getProjectGidByName(zuID, workspaceGid, projectName, zsoid.toString(), apid);
			if (CommonUtil.isEmpty(projectGidLong)) {
				LOGGER.log(Level.WARNING, "Project not found for name: {0} in workspace: {1}", new Object[] { projectName, workspaceName });
				ClientWriter.sendErrorResponse(response, AppticsConstants.NOT_FOUND, "Project Name not found in the selected Workspace");
				return;
			}

			// Create the task
			JSONObject res = handler.addAsanaTask(zuID, workspaceGid, projectGidLong.toString(), taskName, taskDescription, assigneeGid, zsoid.toString(), apid);
			ClientWriter.sendResponse(response, res);

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while creating asana task", e);
			ClientWriter.sendErrorResponse(response, AppticsConstants.EXCEPTION, "Exception while creating asana task, please try again later.");
		}
    }
