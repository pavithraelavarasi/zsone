	public static String getExecutionType(final int option) throws Exception {
		switch (option) {
		case 1:
			return CustomRuntimeConstants.PATH_SCRIPT;
		case 2:
			return CustomRuntimeConstants.PATH_SYMBOLS;
		case 3:
			return CustomRuntimeConstants.PATH_DSYMS;
		case 4:
			return CustomRuntimeConstants.PATH_CRASH;
		default:
			LOGGER.log(Level.INFO, "Invalid option: {0}", option);
			throw new AppticsException("Invalid group: " + option);
		}
	}

	public static int getCrashGroup(final String option) throws Exception {
		switch(option) {
			case "default":
				return 0;//Crash
			case "crash":
				return 0;
			case "hang":
				return 1;
			case "diskwrite":
				return 2;
			case "applaunch":
				return 3;
			case "cpuexception":
				return 4;
			default:
				LOGGER.info("Invalid option: " + option);
				throw new AppticsException("Invalid option: " + option);
		}
	}



	public static String addExceptionsReportNew(JSONObject exceptions, CrashEntity crashEntity) throws Exception {

		LOGGER.log(Level.INFO, "Calling Add ExceptionReport :{0}", exceptions);
		crashEntity.setBundle(crashEntity.getIdentifier());
		
		crashEntity.setExceptionInfo(crashEntity.getMessage().getBytes());	
		String crashtype = crashEntity.getCrashTypeString();
		crashEntity.setBrand(BrandHandler.getInstance().getBrandNameByBrandID(crashEntity.getBrandID()));
	
		if (crashtype.equals(AppticsConstants.NATIVE)) {
			crashEntity.setCrashType(AppticsConstants.EXCEPTIONTYPE_NATIVE);
			
			if (crashEntity.getBrand().equals(AppticsConstants.APPLE) && !crashEntity.getExceptionGroup().equals(AppticsConstants.NONFATAL_GROUP)) {
				processAppleCrashes(crashEntity);
				
			}  else if (crashEntity.getBrand().equals(AppticsConstants.GOOGLE) && !crashEntity.getExceptionGroup().equals(AppticsConstants.NONFATAL_GROUP)) {
				processNativeObfuscation(crashEntity);
			}
			
		} else if (crashtype.equals(AppticsConstants.REACTNATIVE)) {
			crashEntity.setCrashType(AppticsConstants.EXCEPTIONTYPE_REACTNATIVE);
			processReactReport(crashEntity);
		} else if (crashtype.equals(AppticsConstants.FLUTTER)) {
			crashEntity.setCrashType(AppticsConstants.EXCEPTIONTYPE_FLUTTER);
			processFlutterReport(crashEntity);
		} else {
			crashEntity.setCrashType(AppticsConstants.EXCEPTIONTYPE_ALL);
		}

		if (crashEntity.getIsProductionProcess()) {
			addApplicationReportNew(crashEntity);
		
		if (crashtype.equals(AppticsConstants.NATIVE) && crashEntity.getExceptionGroup().equals(AppticsConstants.FATAL) && !crashEntity.getUniqueID().equals(AppticsConstants.BOOKS_ISSUEMSGID) && !crashEntity.getUniqueID().equals(AppticsConstants.INVOICE_ISSUEMSGID)) {
			sendNotification(crashEntity);
		}
		
		}
		
		return crashtype;
	}
