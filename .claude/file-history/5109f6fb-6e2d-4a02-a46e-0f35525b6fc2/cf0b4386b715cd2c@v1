	public static void processFlutterReport(CrashEntity crashEntity) {

		try {
			
			String message = crashEntity.getMessage();

			String crashdetails[] = null;
			String issueName = AppticsConstants.UNSYMBOLICATED;

			Pattern pattern = Pattern.compile("arch:\\s*([\\w\\d]+)");
			Matcher matcher = pattern.matcher(crashEntity.getMessage());
			String architecture = null;
			if (matcher.find()) {
				architecture = matcher.group(1).trim();
			}

			if (CommonUtil.isEmpty(architecture)) {
				crashEntity.setIssueName(issueName);
				addApplicationReport(crashEntity);
			}

			LOGGER.log(Level.INFO, "Calling fetch flutter symbol file");

			String entityName = "app.android-" + architecture + ".symbols";
			if (crashEntity.getPlatform().equalsIgnoreCase(AppticsConstants.IOS)) {
				entityName = "app.ios-" + architecture + ".symbols";
			}

			File symbolFile = fetchFile(AppticsConstants.BUILDFILES, crashEntity);

			File unzipFile = !CommonUtil.isEmpty(symbolFile) ? unzipFile(symbolFile, entityName) : null;

			if (!CommonUtil.isEmpty(unzipFile)) {

				String symbolicatemsg = processHybridSymbolication(crashEntity.getMessage(), unzipFile, crashEntity.getCrashType() == AppticsConstants.EXCEPTIONTYPE_FLUTTER);

				if (!CommonUtil.isEmpty(symbolicatemsg)) {
					if (crashEntity.getCrashType().equals(AppticsConstants.EXCEPTIONTYPE_FLUTTER)) {

						if (symbolicatemsg.contains("#0")) {
							symbolicatemsg = symbolicatemsg.substring(symbolicatemsg.indexOf("#0"));
						}
						String crash = "";
						crashdetails = symbolicatemsg.trim().split("\n");
						Integer line = 0;
						for (String crashline : crashdetails) {
							crashline = crashline.replace("#" + line++, "").trim();
							crashline = crashline.replace(crashline.substring(crashline.indexOf("(") + 1, crashline.lastIndexOf("/") + 1), "");

							crash += crashline + "\n";
						}

						message = crash;
						issueName = crash.substring(0, crash.indexOf("\n"));
					}
				}
			}

			crashEntity.setMessage(CommonUtil.maskPII(message));
			crashEntity.setIssueName(CommonUtil.maskPII(issueName));
			
			CommonUtil.deleteTmpFileInAppServer(symbolFile);
		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception While processing Flutter Crash",e);
		}

	}


	public static String processHybridSymbolication(String message, File file, Boolean isFlutter) {

		LOGGER.log(Level.INFO, "Calling symboication process");

		StringBuilder result = new StringBuilder();
		String command = null;

		BufferedReader reader = null;
		FileWriter wr = null;
		File path = null;

		try {
			path = new File("stactrace.txt");

			wr = new FileWriter(path);
			wr.write(message);
			wr.flush();
			wr.close();

			LOGGER.log(Level.INFO, "symbol file - > {0}", file);
			LOGGER.log(Level.INFO, "message is - > {0}", message);

			LOGGER.log(Level.INFO, "symbole file path -> {0}", file.getAbsolutePath());
			LOGGER.log(Level.INFO, "stacktrace path -> {0}", path.getAbsolutePath());


			if (isFlutter) {
				LOGGER.log(Level.INFO, "Flutter Symbolication");
				command = "flutter symbolize -i " + path + " -d " + file;
				
				try {

						LOGGER.log(Level.INFO, "Disable telemetry");
						ProcessBuilder processBuilder = new ProcessBuilder("/bin/bash", "-c", "flutter --disable-telemetry");

						processBuilder.redirectErrorStream(true);
						Process process = processBuilder.start();
						
						int exitCode = process.waitFor();
						LOGGER.log(Level.INFO, "Exit Code - > {0}", exitCode);
						
					}

				 catch (Exception e) {

					LOGGER.log(Level.INFO, "Exception while disabling telemetry");
				}
			} else {
				LOGGER.log(Level.INFO, "React Symbolication");
				command = "metro-symbolicate " + file + " < " + path;
			}

			LOGGER.log(Level.INFO, "Command is {0}", command);

			ProcessBuilder processBuilder = new ProcessBuilder("/bin/bash", "-c", command);

			processBuilder.redirectErrorStream(true);

			Process process = processBuilder.start();
			reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
			String line = null;

			while ((line = reader.readLine()) != null) {

				result.append(line).append("\n");
			}

			LOGGER.log(Level.INFO, "result is -> {0}", result);

			int exitCode = process.waitFor();
			LOGGER.log(Level.INFO, "Exit Code - > {0}", exitCode);

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while symbolicate crash - >{0} ", e);
		}

		finally {
			try {	
				
				reader.close();
				CommonUtil.deleteTmpFileInAppServer(file);
				CommonUtil.deleteTmpFileInAppServer(path);		
				
			} catch (IOException e) {
				LOGGER.log(Level.SEVERE, "Exception while closing BufferedReader and writer - > {0}", e);
			}
		}
		return result.toString();
	}
	
	private static File unzipFile(File symbolFile, String entityName) {
		File outputFile = null;
		ZipFile zipFile = null;

		FileOutputStream outputStream = null;
		InputStream inputStream = null;
		
		try {

			zipFile = new ZipFile(symbolFile.getAbsolutePath());
			ZipEntry entry = zipFile.getEntry(entityName);
			LOGGER.log(Level.INFO, "Entry{0}", entry);

			LOGGER.log(Level.INFO, "Build File path -> {0}", symbolFile.getAbsolutePath());

			if (entry != null) {

				inputStream = zipFile.getInputStream(entry);

				outputFile = new File("build.txt");
				LOGGER.log(Level.INFO, "outputFile : {0}", outputFile);
				outputStream = new FileOutputStream(outputFile);

			}

			LOGGER.log(Level.INFO, "outputStream : {0}", outputStream);

			byte[] buffer = new byte[1024];
			int bytesRead;
			while ((bytesRead = inputStream.read(buffer)) != -1) {
				outputStream.write(buffer, 0, bytesRead);
			}

		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while Unzip the file", e);
		} finally {

			try {
				outputStream.close();
				inputStream.close();
				zipFile.close();
			} catch (Exception e) {
				LOGGER.log(Level.SEVERE, "Exception while closing Streams ", e);
			}
		}
		LOGGER.log(Level.INFO, "outputFile : {0}", outputFile);

		return outputFile;
	}


