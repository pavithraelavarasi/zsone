	public static String findIssueName(String message,String crashGroup) {
		
		LOGGER.log(Level.INFO, "Find Issue Name called");
		String issueName = AppticsConstants.UNSYMBOLICATED + " - " + crashGroup;
		
		try {
			Pattern crashedThreadPattern = Pattern.compile("Crashed Thread:\\s*(\\d+)");
			Matcher crashedThreadMatcher = crashedThreadPattern.matcher(message);

			if (crashedThreadMatcher.find()) {
				int crashedThreadNumber = Integer.parseInt(crashedThreadMatcher.group(1));

				int startIndex = message.indexOf("Thread " + crashedThreadNumber++); // store the crashed thread number for thread usage
				int endIndex = message.contains("Thread " + crashedThreadNumber) ? message.indexOf("Thread " + crashedThreadNumber) : message.indexOf("Thread State:");
				// end Index the next number of the crashed thread
				if (startIndex < endIndex) {
					String[] threadLine = message.substring(startIndex, endIndex).split("\n");

					for (String line : threadLine) {

						Pattern pattern = Pattern.compile(AppticsConstants.TRACEREGEX);
						if (!pattern.matcher(line).matches() && Character.isDigit(line.charAt(0))) {
							LOGGER.log(Level.INFO, "unsymbolicated line is {0}",line);
							
							line = line.replaceAll("^\\d+", "");
							return line;
						}	
					}
				}
			} else {
				return issueName;
			}
		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception while find the issuename for missing symbols ", e);
		}
		return issueName;
	}

	

