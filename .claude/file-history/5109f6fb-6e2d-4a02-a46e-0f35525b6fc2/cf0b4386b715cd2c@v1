		sb.append("Screen : " + crashentity.getScreenName() + "\n\n");

		return sb.toString();
	}


	private static String windowsMessageOperation(String message, String appName) {
		
		String[] arr = message.split("\n");		
		
		 Pattern pattern = Pattern.compile(String.join("|", appName.split("\\s+")));

		    for (String line : message.split("\n")) {

		        if (pattern.matcher(line).find()) {
		            int last = line.lastIndexOf('.');
		            int prev = line.lastIndexOf('.', last - 1);
		            return prev > -1 ? line.substring(prev + 1, last) : null;
		        }
		    }
		 
		 for (String s : arr) {
			 if(s.contains("at ")) {
				 
				 String[] parts = s.split("\\.");
		        if (parts.length >= 2) {
		             return parts[parts.length - 2];
		        }
			 }
	        }
		 
        return arr[0];
    }
	

