	/**
	 * Processes Apple crash reports by extracting UUID from binary images
	 * and dispatching to the appropriate symbolication backend.
	 *
	 * Dispatch logic based on server type (machineType):
	 * - "both"  : prefer Linux if APID is in linux symbolication list, else Mac. Enables fallback (reProcess).
	 * - "linux" : Linux only
	 * - "mac"   : Mac only
	 */
	private static void processAppleCrashes(CrashEntity crashEntity) throws Exception {

		// Extract UUID from "Binary Images:" section of the crash log
		try {
			String message = crashEntity.getMessage();
			if (message.contains("Binary Images:")) {
				String uuid = message.substring(message.indexOf("Binary Images:"));
				int langle = uuid.indexOf('<');
				int rangle = uuid.indexOf('>');

				if (langle != -1 && rangle != -1 && langle < rangle) {
					uuid = uuid.substring(langle + 1, rangle);
				} else {
					uuid = "-";
				}

				crashEntity.setUuid(uuid);
			}
		} catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Exception while getting uuid --> {0}", e);
		}

		// Determine symbolication backend
		String machineType = PropertyHandler.getValue(CustomRuntimeConstants.SERVERTYPE);
		machineType = machineType == null ? "both" : machineType;
		crashEntity.setMachineType(machineType);

		if (machineType.equals("both")) {
			crashEntity.setReProcess(true);
			final String linuxApps = PropertyHandler.getValue(CustomRuntimeConstants.LINUX_SYMBOLICATION);
			LOGGER.log(Level.INFO, "Linux symbolication apids {0}", linuxApps);

			if (!CommonUtil.isEmpty(linuxApps) && linuxApps.contains(crashEntity.getApID().toString())) {
				LOGGER.log(Level.INFO, "Linux Symbolication for this apid {0}", crashEntity.getApID());
				linuxSymbolication(crashEntity);
			} else {
				LOGGER.log(Level.INFO, "Linux not enabled for the apid {0}", crashEntity.getApID());
				processNativeSymboliction(crashEntity);
			}
		} else if (machineType.equals("linux")) {
			LOGGER.log(Level.INFO, "Linux Only Server");
			linuxSymbolication(crashEntity);
		} else if (machineType.equals("mac")) {
			LOGGER.log(Level.INFO, "Mac Only Server");
			processNativeSymboliction(crashEntity);
		} else {
			LOGGER.log(Level.INFO, "Unsupported machine type: {0}", machineType);
		}

	}

	/**
	 * Performs Linux-based crash symbolication on a custom runtime instance.
	 *
	 * Flow:
	 * 1. Check if symbolication is disabled for this APID
	 * 2. Resolve the custom runtime domain:
	 *    - crTestApp projects -> fetch domain from DB via getDomainFromCRInstance
	 *    - All other projects -> use default CustomRuntimeConstants.DOMAIN
	 * 3. Check if the dSYM file already exists on the runtime
	 * 4. If dSYM is missing, upload it:
	 *    - crTestApp projects -> use DSymFilesHandler.copyDsymToCustomRuntime (handles upload + extract internally)
	 *    - All other projects -> upload via HTTP and clean up the zip
	 * 5. Write crash log to a temp file and upload to the runtime's crash folder
	 * 6. Execute the Perl symbolication script on the runtime
	 * 7. Read the symbolicated output JSON
	 * 8. Clean up temp crash files on the runtime
	 * 9. Parse symbolicated result and update crashEntity with issue name and message
	 * 10. On failure, fall back to Mac symbolication if reProcess is enabled
	 */
	private static void linuxSymbolication(CrashEntity crashEntity) throws Exception {

		try {

			// Step 1: Check if symbolication is disabled for this APID
			final String disabledApID = PropertyHandler.getValue(SdkConstants.DISBALEDSYMBOLICATIONAPID);
			if (disabledApID != null && disabledApID.contains(crashEntity.getApID() + "")) {
				LOGGER.log(Level.INFO, "Symbolication disabled for the apid {0}", crashEntity.getApID());
				return;
			}

			// Step 2: Resolve domain - crTestApp uses DB lookup, others use default
			String dsymFile = crashEntity.getAppVersionID() + "_" + crashEntity.getAppReleaseVersionID();
			crashEntity.setBuildFileName(dsymFile);

			String zsoid = crashEntity.getZsoid();
			if (CommonUtil.isEmpty(zsoid)) {
				zsoid = DataspaceAndAppMapper.getInstance().getOrgLoginname(crashEntity.getProjectID());
			}

			String domain = CustomRuntimeConstants.DOMAIN;
			String testApps = PropertyHandler.getValue("crTestApps");
			boolean isCrTestApp = testApps != null && testApps.contains(crashEntity.getProjectID().toString());

			if (isCrTestApp) {
				domain = CustomRuntimeConstants.getDomainFromCRInstance(String.valueOf(crashEntity.getProjectID()), zsoid);
			}

			String executeUrl = domain + CustomRuntimeConstants.URL_EXECUTE_SUFFIX;

			// Step 3: Check if dSYM file exists on the runtime
			String fileCheckCommand = executeUrl + "[+-d+" + CustomRuntimeConstants.PATH_DSYMS + dsymFile + "+]" + CustomRuntimeConstants.FLAG_CHECK;
			String isFileThere = executeLinuxCommand(fileCheckCommand, crashEntity, true);

			// Step 4: Upload dSYM if not present
			if (!isFileThere.contains(CustomRuntimeConstants.TRUE)) {
				LOGGER.log(Level.INFO, "dSYM not found on runtime, fetching from DB");
				File dsymfile = fetchFile(AppticsConstants.DSYMTABLE, crashEntity);

				if (CommonUtil.isEmpty(dsymfile)) {
					LOGGER.log(Level.INFO, "Dsym file not there");
					String displayName = ProjectHandler.getDisplayName(crashEntity.getProjectID());
					String issueName = "Missing dSYMs for [" + displayName + "]";
					crashEntity.setIssueName(CommonUtil.maskPII(issueName));
					crashEntity.setMessage(CommonUtil.maskPII(crashEntity.getMessage()));
					return;
				}

				LOGGER.log(Level.INFO, "Uploading dSYM to linux machine for projectID {0}, isCrTestApp={1}", new Object[]{crashEntity.getProjectID(), isCrTestApp});
				String uploadCommand = domain + CustomRuntimeConstants.URL_UPLOAD + getExecutionType(3);
				uploadFile(dsymfile.getAbsolutePath(), uploadCommand, crashEntity.getBuildFileName(), getExecutionType(3), true, crashEntity);

				String rmCommand = executeUrl + "rm+" + CustomRuntimeConstants.PATH_DSYMS + dsymfile.getName();
				executeLinuxCommand(rmCommand, crashEntity, false);
			}

			// Step 5: Write crash log to temp file and upload to runtime
			String issueName = AppticsConstants.UNSYMBOLICATED + " - " + crashEntity.getCrashGroupString();
			String message = crashEntity.getMessage();

			String crashFileName = crashEntity.getAppVersionID() + "_" + crashEntity.getAppReleaseVersion() + "_" + System.currentTimeMillis();
			crashEntity.setCrashFileName(crashFileName);
			LOGGER.log(Level.INFO, "Uploading crash file {0}", crashFileName);

			Path filePath = Path.of(crashFileName + ".crash");
			Files.writeString(filePath, crashEntity.getMessage(), StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);

			String crashUploadUrl = domain + CustomRuntimeConstants.URL_UPLOAD + getExecutionType(4);
			uploadFile(filePath.getFileName().toString(), crashUploadUrl, crashEntity.getCrashFileName() + ".crash", null, false, crashEntity);

			// Step 6: Execute symbolication script
			String scriptCommand = executeUrl
					+ "perl+apptics/script/symbolicator.pl+apptics/crashfile/" + crashEntity.getCrashFileName() + ".crash"
					+ "+" + crashEntity.getFrameworkVersion()
					+ "+" + CustomRuntimeConstants.PATH_DSYMS + crashEntity.getBuildFileName();
			LOGGER.log(Level.INFO, "Symbolication command: {0}", scriptCommand);
			executeLinuxCommand(scriptCommand, crashEntity, true);

			// Step 7: Read symbolicated output
			String readOutputCommand = executeUrl + "cat+" + CustomRuntimeConstants.PATH_CRASH + crashEntity.getCrashFileName() + ".json";
			String output = executeLinuxCommand(readOutputCommand, crashEntity, false);

			// Step 8: Clean up temp files on runtime
			String cleanupCommand = executeUrl + "rm+"
					+ CustomRuntimeConstants.PATH_CRASH + crashEntity.getCrashFileName() + "+"
					+ CustomRuntimeConstants.PATH_CRASH + crashEntity.getCrashFileName() + ".crash" + "+"
					+ CustomRuntimeConstants.PATH_CRASH + crashEntity.getCrashFileName() + ".json";
			executeLinuxCommand(cleanupCommand, crashEntity, false);

			// Step 9: Parse symbolicated result
			JSONObject crashDetails = new JSONObject(output);

			if (!CommonUtil.isEmpty(crashDetails)) {
				message = crashDetails.getString("crash");
				String crashTitle = crashDetails.getString("crash_title");
				String crashType = crashDetails.getString("crash_type");

				crashTitle = crashTitle.trim().isEmpty() ? AppticsConstants.OTHERS : crashTitle;
				LOGGER.log(Level.INFO, "CrashTitle is {0}", crashTitle);

				issueName = crashTitle + "\n" + (CommonUtil.isEmpty(crashType) ? "" : crashType);

				String library = crashDetails.getString("crashed_library");
				String head = crashDetails.getString("crash_description");
				LOGGER.log(Level.INFO, "Heading for the crash {0} and library {1}", new Object[]{head, library});
			}

			if (issueName.contains(AppticsConstants.MISSINGSYMBOLS)) {
				LOGGER.log(Level.INFO, "Resolving missing symbols issueName {0}", issueName);
				issueName = findIssueName(message, crashEntity.getCrashGroupString());
			}

			LOGGER.log(Level.INFO, "IssueName is {0}", issueName);
			SdkUtil.sendLinuxException("SUCCESS -->" + issueName, crashEntity.getProjectID());

			crashEntity.setMessage(CommonUtil.maskPII(message));
			crashEntity.setIssueName(CommonUtil.maskPII(issueName));

		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception while processing linux symbolications apid : {0} error : {1}", new Object[]{crashEntity.getApID(), e});
			SdkUtil.sendLinuxException("FAILED -->" + e, crashEntity.getProjectID());

			// Step 10: Fallback to Mac symbolication if reProcess is enabled
			if (crashEntity.getReProcess()) {
				crashEntity.setReProcess(false);
				LOGGER.log(Level.INFO, "Failed on Linux so ReProcess to Mac");
				processNativeSymboliction(crashEntity);
			}
		}

	}

    private static Long getCRID(Long projectID) {

        LOGGER.log(Level.INFO, "getting crid from db");
        Long crid = 0l;

        try {
            String table = "JApplications";

            SelectQuery sq = new SelectQueryImpl(Table.getTable(table));
            sq.addSelectColumn(Column.getColumn(table, "*"));

            sq.setCriteria(new Criteria(new Column(table, AppticsConstants.APPID), projectID, QueryConstants.EQUAL));

            Persistence p = DBHandler.getPersistence();
            DataObject dobj = p.get(sq);

            Row row = dobj.getFirstRow(table);

            String additional = row.getString("AdditionalDetails");

            JSONObject js = new JSONObject(additional);

            if(js.has("crid")) {
                return js.getLong("crid");
            }
        }
        catch(Exception e){
            LOGGER.log(Level.INFO, "Exception while getting crid");
        }
        return crid;

    }



    public static void uploadFile(String filePath, String targetURL,String fileName,String exePath,Boolean isExtract,CrashEntity crashentity) throws Exception {
        String boundary = "----Boundary" + System.currentTimeMillis(); //  setting boundary for avoiding n number of uploads
        String LINE_FEED = "\r\n";

        URL url = new URL(targetURL);
        HttpURLConnection  httpConn = (HttpURLConnection) url.openConnection();
        DataOutputStream request = null;

        try {
        	
        	if(CommonUtil.isEmpty(crashentity.getLinuxAuth())) {
             crashentity.setLinuxAuth(getAuthKey());
        	}
        	// Open connection
           
        	
            httpConn.setUseCaches(false);
            httpConn.setDoOutput(true);
            httpConn.setDoInput(true);
            httpConn.setRequestMethod("POST");
            httpConn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
            httpConn.setRequestProperty("appticsauthkey", crashentity.getLinuxAuth());
            
            httpConn.setConnectTimeout(5000);
        	httpConn.setReadTimeout(5000);

            request = new DataOutputStream(httpConn.getOutputStream());

            // Add file
            File file = new File(filePath);
            

            request.writeBytes("--" + boundary + LINE_FEED);
            request.writeBytes("Content-Disposition: form-data; name=\"file\"; filename=\"" + file.getName() + "\"" + LINE_FEED);
            request.writeBytes("Content-Type: " + HttpURLConnection.guessContentTypeFromName(file.getName()) + LINE_FEED);
            request.writeBytes(LINE_FEED);

            try (FileInputStream inputStream = new FileInputStream(file)) {
                byte[] buffer = new byte[4096];
                int bytesRead;
                while ((bytesRead = inputStream.read(buffer)) != -1) {
                    request.write(buffer, 0, bytesRead);
                }
            }

            request.writeBytes(LINE_FEED);
            request.writeBytes("--" + boundary + "--" + LINE_FEED);
            request.flush();

            // Get response
            int responseCode = httpConn.getResponseCode();
            LOGGER.log(Level.INFO, "File Upload Response Code: ", responseCode);

            try (BufferedReader responseReader = new BufferedReader(new InputStreamReader(httpConn.getInputStream()))) {
                String responseLine;
                while ((responseLine = responseReader.readLine()) != null) {
                	LOGGER.log(Level.INFO, "Response ", responseLine);
                }
                
                if (isExtract) {
                	// Derive domain from the upload targetURL to ensure unzip runs on the same server
                	String uploadDomain = targetURL.substring(0, targetURL.indexOf("/", targetURL.indexOf("//") + 2));
                	String command = uploadDomain + CustomRuntimeConstants.URL_EXECUTE_SUFFIX + "unzip+" + exePath + file.getName() + "+" + "-d+" + exePath + fileName + "+-x+__MACOSX/*";
                	executeLinuxCommand(command, crashentity, false);
                }
                
            }
            

        } catch (Exception e) {
        	LOGGER.log(Level.INFO, "Exception while uploading files ", e);
        } finally {
            if (request != null) {
                try {
                    request.close();
                } catch (IOException ignored) {}
            }
            if (httpConn != null) {
                httpConn.disconnect();
            }
        }
    }
