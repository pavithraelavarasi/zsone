    private static void sendToMsTeams(
            String module,
            String subType,
            Long apId,
            String displayName,
            String crashUrl,
            CrashEntity crash
    ) {

        String header = displayName + " | " + crash.getAppVersion() + " | " + crash.getPlatform() + " | " + crash.getOsVersion() + " | " + crash.getDeviceModel();
        String classLineInfo = null;
        String screenName = null;

        String os = crash.getPlatform();
        if ("Android".equalsIgnoreCase(os)) {
            List<String> msg = CommonUtil.getClassAndLineNumber(crash.getMessage());
            String line = "";
            String className = "";
            //msg contains class name and linenumber
            if(msg.size() >= 2){
                className = msg.get(0);
                line = msg.get(1);
            }

            classLineInfo = className +" (line "+line+" )";
            screenName = crash.getScreenName();
        } else if ("Windows".equalsIgnoreCase(os)) {
            String message = crash.getMessage();
            if (!CommonUtil.isEmpty(message)) {
                String className = windowsMessageOperation(message,displayName);
                LOGGER.log(Level.INFO,"Class Name {0}",className);
                classLineInfo = className;
            }
        }

        Integrations.MSTEAMS.sendCrash(
                apId,
                module,
                subType,
                header,
                crash.getIssueName(),
                classLineInfo,
                screenName,
                crashUrl
        );
    }


