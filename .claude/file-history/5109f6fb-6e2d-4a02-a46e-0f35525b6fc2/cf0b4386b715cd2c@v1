	public static JSONObject decodeException(JSONObject exception,String exceptiongroup,Long appID,String exceptiontype) throws Exception {
		
		JSONObject result = new JSONObject();
		try {
			
		CrashEntity crashentity = new CrashEntity();
		crashentity.setExceptionGroup(exceptiongroup);
		crashentity.setProjectID(appID);
		
		setException(crashentity,exception);
		
		crashentity.setExceptionGroup(exceptiongroup);
		crashentity.setCrashGroup(SdkConstants.CUSTOM_TYPE);
		crashentity.setCrashGroupString(SdkConstants.S_DEFAULT);


		if (exceptiontype.equals(AppticsConstants.NATIVE)) {
			crashentity.setCrashType(AppticsConstants.EXCEPTIONTYPE_NATIVE);
			
			if (crashentity.getBrand().equals(AppticsConstants.APPLE) && !crashentity.getExceptionGroup().equals(AppticsConstants.NONFATAL_GROUP)) {
				processAppleCrashes(crashentity);

			}  else if (crashentity.getBrand().equals(AppticsConstants.GOOGLE)) {
				processNativeObfuscation(crashentity);
			}
			
			String message = crashentity.getMessage();
			
			if(!exception.getString(AppticsConstants.MESSAGE).equals(message))
			{
			   setReports(exception,crashentity);
			   result.put("message", crashentity.getMessage());
			   result.put("isSymbolicated", true);


			}
			else {
				result.put("isSymbolicated", false);
			}
		}

		else {
			result.put("isSymbolicated", false);
		}
		
		}
		catch(Exception e)
		{
			LOGGER.log(Level.INFO, "Exception while setting crashentity -> {0}  ", e);
			throw new Exception("Exception while setting crashentity {0}", e);
		}
		
		return result;
	}

	private static void setReports(JSONObject exception,CrashEntity crashentity) throws Exception {

		String uniqueColumn = AppticsConstants.UNIQUEMESSAGEID_C;
		setUniqueID(crashentity);
		LOGGER.log(Level.INFO, "Unique MessageID {0}",crashentity.getUniqueID());

		exception.put(AppticsConstants.MESSAGE, crashentity.getMessage());
		exception.put(AppticsConstants.ISSUENAME,crashentity.getIssueName());
		exception.put(AppticsConstants.INSERTTIME, System.currentTimeMillis());


		if(crashentity.getExceptionGroup().equals(AppticsConstants.NONFATAL_GROUP)) {
			uniqueColumn = AppticsConstants.UNIQUEMESSAGEID;
		}
		else {
			exception.put(AppticsConstants.CRASHGROUP, crashentity.getCrashGroup());
		}

		exception.put(uniqueColumn, crashentity.getUniqueID());

		ExceptionsHandler.addReports(crashentity,true, exception);
	}

