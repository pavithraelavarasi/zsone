		Long apID = 0l;
		String appRelVersion;
		String screenname = null;
		Long platformID = exception.has(AppticsConstants.PLATFORM_ID)?exception.getLong(AppticsConstants.PLATFORM_ID):0l;
		String messageInfo = null;


		if(exception.has(AppticsConstants.MODE)) {
			crashentity.setMode(exception.getInt(AppticsConstants.MODE));
		}
		else {
			LOGGER.log(Level.INFO ,"Empty mode");
			throw new Exception("Mode is Empty");
		}


		LOGGER.log(Level.INFO, "Exception details {0}", exception);
		
		if(crashentity.getExceptionGroup().equals(AppticsConstants.NONFATAL_GROUP)) {
			messageInfo = exception.has(AppticsConstants.NONFATALINFO)? exception.getString(AppticsConstants.NONFATALINFO): null;

			Integer appVersionTag = exception.has(AppticsConstants.APPVERSIONID)?exception.getInt(AppticsConstants.APPVERSIONID):0;
			appVersionID = AppVersionHandler.getInstance().getVersionIDByTag(appVersionTag);
			
			Integer identifierTag = exception.has(AppticsConstants.IDENTIFIERID)?exception.getInt(AppticsConstants.IDENTIFIERID):0;
			apID = AppHandler.getInstance().getAPIDByTag(identifierTag);
			
			Integer projectTag = exception.has(AppticsConstants.APPID)?exception.getInt(AppticsConstants.APPID):0;
			
			Integer appRelVersionTag = exception.has(AppticsConstants.APPRELEASEVERSIONID)?exception.getInt(AppticsConstants.APPRELEASEVERSIONID):0;
			appRelVersion = AppReleaseVersionHandler.getappReleaseVersionbyTag(appRelVersionTag);
			Integer screenTag = exception.has(AppticsConstants.SCREENID)?exception.getInt(AppticsConstants.SCREENID):0;
			ScreenData sc = new ScreenData();
			sc.setScreenTag(screenTag);
			sc.setProjectID(crashentity.getProjectID());
			sc.setPlatformID(platformID);
			sc = ScreenUtil.getInstance().getScreenDatabyTag(sc);

			screenname = sc.getScreenName();

			crashentity.setAppVersionTag(appVersionTag);
			crashentity.setIdentifierTag(identifierTag);
			crashentity.setProjectTag(projectTag);
		}
		
		else {
			 messageInfo = exception.has(AppticsConstants.CRASHINFO)? exception.getString(AppticsConstants.CRASHINFO): null;
			 appVersionID = exception.has(AppticsConstants.APPVERSIONID)?exception.getLong(AppticsConstants.APPVERSIONID):0l;
			 apID = exception.has(AppticsConstants.IDENTIFIERID)? exception.getLong(AppticsConstants.IDENTIFIERID):0l;
			 appRelVersion = exception.has(AppticsConstants.APPRELEASEVERSION)?exception.getString(AppticsConstants.APPRELEASEVERSION):null;
			 screenname = exception.has(AppticsConstants.SCREEN)?exception.getString(AppticsConstants.SCREEN):null;

			 crashentity.setFrameworkVersion(exception.getString(AppticsConstants.JANALYTICVERSION));

		}

		String message = messageInfo;
		if(message == null || message.trim().equals("-")) {
			message = exception.has(AppticsConstants.MESSAGE)?exception.getString(AppticsConstants.MESSAGE):null;
			messageInfo = message;
		}

		
		Long brandID = PlatformHandler.getInstance().getBIDByPIDTag(PlatformHandler.getInstance().getPlatformTagByPlatformID(platformID));
		String brand = BrandHandler.getInstance().getBrandNameByBrandID(brandID);

		crashentity.setDeSymbolicatedMessage(message);
		crashentity.setMessage(message);
		crashentity.setAppVersionID(appVersionID);
		crashentity.setAppReleaseVersion(appRelVersion);
		crashentity.setAppVersion(AppVersionHandler.getInstance().getVersion(appVersionID));
		Long appReleaseVersionID = AppReleaseVersionHandler.getAppReleaseVersionID(appRelVersion, apID);
		crashentity.setAppReleaseVersionID(appReleaseVersionID);
		crashentity.setApID(apID);
		crashentity.setPlatform(PlatformHandler.getInstance().getOSByPlatformID(platformID));
	    crashentity.setExceptionInfo(messageInfo.getBytes());
		crashentity.setBundle(AppHandler.getInstance().getIdentifierByAPID(apID));
		crashentity.setMailContent(message);
		crashentity.setHappenedAt(exception.getLong(AppticsConstants.HAPPENEDAT));
		crashentity.setDeviceID(exception.getLong(AppticsConstants.DEVICEID));
		crashentity.setBrand(brand);
		crashentity.setScreenName(screenname);
		crashentity.setPlatformID(platformID);



		Integer crashgroup = exception.has(AppticsConstants.CRASHGROUP)?exception.getInt(AppticsConstants.CRASHGROUP):0; //for linux operations
		crashentity.setCrashGroup(crashgroup);
		crashentity.setCrashGroupString(CrashEntity.getCrashGroupString(crashgroup));
	}

	public static String executeLinuxCommand(String targetURL,CrashEntity crashentity,Boolean isRunScript) throws Exception {


		if(CommonUtil.isEmpty(crashentity.getLinuxAuth())) {
			crashentity.setLinuxAuth(getAuthKey());
			}

		Integer readTime = 5000;
		if(isRunScript) {
			readTime = 120000;
		}
		URL url = new URL(targetURL);
		HttpURLConnection connection = (HttpURLConnection) url.openConnection();
		try {

			connection.setRequestMethod("POST");
			connection.setDoOutput(true);
			connection.setRequestProperty("User-Agent", "Mozilla/5.0");
			connection.setRequestProperty("appticsauthkey", crashentity.getLinuxAuth());

			connection.setConnectTimeout(readTime);
			connection.setReadTimeout(readTime);

			int responseCode = connection.getResponseCode();
			if (responseCode == HttpURLConnection.HTTP_OK) {
				BufferedReader in = new BufferedReader(new InputStreamReader(connection.getInputStream()));
				String inputLine;
				StringBuilder response = new StringBuilder();

				while ((inputLine = in.readLine()) != null) {
					response.append(inputLine);
				}
				in.close();

				String s = new String(response);
				JSONObject js = new JSONObject(s);

				if (!CommonUtil.isEmpty(js) && js.has("output")) {
					return js.getString("output");
				}
				throw new Exception("Exception while run comment");
			} else {
				LOGGER.log(Level.INFO, "Exception while running command files ");
				throw new Exception("Exception while run comment");
			}

		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception while execute the comment {0} , {1}", new Object[] { targetURL, e });
			throw new Exception("Exception while run comment");
		} finally {
			if (connection != null) {
				connection.disconnect();
			}
		}
	}
