				}
				
				if(issueName.contains(AppticsConstants.MISSINGSYMBOLS)) {
					LOGGER.log(Level.INFO, "change the issuename {0}", issueName);
					issueName = findIssueName(message,crashentity.getCrashGroupString());
				}
				LOGGER.log(Level.INFO, "IssueName is {0}", issueName);
				
				crashentity.setMessage(CommonUtil.maskPII(message));
				crashentity.setIssueName(CommonUtil.maskPII(issueName));
				
