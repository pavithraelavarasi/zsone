	private static File fetchFile(String tableName, CrashEntity crashentity) {

		LOGGER.log(Level.INFO, "Fetch file from the table {0}", tableName);

		SelectQuery sq = new SelectQueryImpl(Table.getTable(tableName));
		sq.addSelectColumn(Column.getColumn(tableName, "*"));

		Criteria c;

		if (tableName.equals(AppticsConstants.DSYMTABLE)) {
			c = new Criteria(Column.getColumn(tableName, AppticsConstants.APPVERSIONID), crashentity.getAppVersionID(), QueryConstants.EQUAL);
			c = c.and(new Criteria(Column.getColumn(tableName, AppticsConstants.APPRELEASEVERSION), crashentity.getAppReleaseVersion(), QueryConstants.EQUAL));
		}
		else if(tableName.equals(AppticsConstants.BUILDMAPPINGFILES)) {
			
			c = new Criteria(Column.getColumn(tableName, AppticsConstants.APPVERSION),crashentity.getAppReleaseVersion(), QueryConstants.EQUAL);
			c = c.and(new Criteria(Column.getColumn(tableName, "AppVersionName"), crashentity.getAppVersion(), QueryConstants.EQUAL)
					.and(Column.getColumn(tableName,AppticsConstants.PACKAGEID), crashentity.getApID(), QueryConstants.EQUAL));
			
		}
		else { //for react native and flutter
			c = new Criteria(Column.getColumn(tableName, AppticsConstants.APPVERSIONID), crashentity.getAppVersionID(), QueryConstants.EQUAL);
			c = c.and(new Criteria(Column.getColumn(tableName, AppticsConstants.APPRELEASEVERSIONID), crashentity.getAppReleaseVersionID(), QueryConstants.EQUAL));
		}
		sq.setCriteria(c);

		DataObject dobj = null;

		try {
			dobj = DBHandler.getPersistence().get(sq);
			if (!dobj.containsTable(tableName)) {
				LOGGER.log(Level.INFO, "Table not found");
				return null;
			}
			Row r = dobj.getFirstRow(tableName);

			String dfspath = (String) r.get(AppticsConstants.DFSFILEPATH);
			String blockID = (String) r.get(AppticsConstants.BLOCKID);

			LOGGER.log(Level.INFO, "dfsPath -> {0}, blockID --> {1}", new Object[] { dfspath, blockID });

			File buildfile = DFSFileHandler.dfsFileReadReturnFile(dfspath, blockID, crashentity.getProjectID());		
			
			if (!CommonUtil.isEmpty(buildfile) && tableName.equals(AppticsConstants.DSYMTABLE)) {
				crashentity.setDsymPath(dfspath);
			}

			return buildfile;

		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception while fetching build file");
			return null;
		}
	}


	private static String copyDSymFiletoMac(CrashEntity crashentity, File f, String fileName, DSymServer mac, String buildLocation,String processFor) {
		
		String host = mac.host;
		String pass = mac.password;
		String username = mac.username;
		String result= "";
		
		LOGGER.log(Level.INFO,"Copy the dsym file to mac machine {0}",host);


		try {
			SshExecutor.executeCommand(new SshConfig(host, username, pass, "mkdir -p " + AppticsConstants.DSYMFILELOCATION));
		} catch (Exception e) {
			LOGGER.info("Exception in permission");
			host = mac.removeNode(crashentity.getProjectID());
		}

		try {
			
			SshConfig config = new SshConfig(host, username, pass, f.getAbsolutePath(), AppticsConstants.DSYMFILELOCATION + fileName); // config - Connection detail and file names

			SshExecutor.copyLocalFileToRemoteHost(config);
			
			LOGGER.log(Level.INFO,"using ditto to unzip the dsym");

			SshExecutor.executeCommand(new SshConfig(host, username, pass, "rm -rvf " + buildLocation + "; ditto -x -k " + AppticsConstants.DSYMFILELOCATION + fileName + " " + buildLocation));

			SshExecutor.executeCommand(new SshConfig(host, username, pass, "rm -rvf " + AppticsConstants.DSYMFILELOCATION + fileName));
			
			
			if(processFor.equals(AppticsConstants.FILEUPLOAD)) {
			String command;			
			
			String reFile = SshExecutor.executeCommand(new SshConfig(host, username, pass, "find " + buildLocation + " -maxdepth 1  -name \"*.dSYM\""));

			command = "dwarfdump -u " + buildLocation + "/*.app.dSYM";

			if (CommonUtil.isEmpty(reFile)) {
				command = "dwarfdump -u " + buildLocation + "/**/*.app.dSYM";
			}

			else if (reFile.trim().split("\\.dSYM").length == 1) {
				LOGGER.log(Level.INFO, "Change the wrong name");
				String reName = reFile.substring(reFile.lastIndexOf("/")).trim();
				reName = reName.replace(".", "_");
				SshExecutor.executeCommand(new SshConfig(host, username, pass, "mv " + buildLocation + "/*.dSYM " + buildLocation + reName));
				command = "dwarfdump -u " + buildLocation + reName + "/*.app.dSYM";
			}		
			
				
				try {		
					   LOGGER.info("Get uuid of dsym file");
					
						SshConfig config1 = new SshConfig(host, username, pass, command);

					    result = SshExecutor.executeCommand(config1);
						result = result.replace(" ", "");
						result = result.substring(result.indexOf(":") + 1, result.indexOf("("));
						result = result.replaceAll("-", "").toLowerCase();

						LOGGER.log(Level.INFO, "uuid is {0}", result);
										
					} catch (Exception e) {
						LOGGER.log(Level.INFO, "Exception while getting uuid :", e);
						
					}
				try {
					LOGGER.log(Level.INFO, "Remove the folder from mac");
					SshExecutor.executeCommand(new SshConfig(host, username, pass, "rm -rvf " + buildLocation));
				} catch (Exception e) {
					LOGGER.log(Level.INFO, "Not Contain the folder");
				}
			}
			
		}catch (Exception e) {
			LOGGER.log(Level.SEVERE, "Dsym File: ", e);
		}
		
		finally {

			CommonUtil.deleteTmpFileInAppServer(f);
		}
		return result;
	}


