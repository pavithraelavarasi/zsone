				Row r = dobj.getFirstRow(tableName);
				uniqueIDres.put((Long) r.get(pkCol), false);

			}

			return uniqueIDres;
		} catch (Exception e) {
			LOGGER.info("Exception while fetching unique message id " + e);
			return uniqueIDres;
		}
	}
	
