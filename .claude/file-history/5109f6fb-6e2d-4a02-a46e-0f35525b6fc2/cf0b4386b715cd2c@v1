	private String getMainExecutableName(String[] lines) {

		Pattern pattern = Pattern.compile("^Process:\\s+([a-zA-Z\\s_-]+)\\s +\\[\\d+\\]");
		for (String line : lines) {
			Matcher matcher = pattern.matcher(line);
			if (matcher.matches()) {
				return matcher.group(1);
			}
		}

		return null;
	}

	
	private static String getAuthKey() throws Exception {
		
		FileInputStream fis = new FileInputStream(AppticsConstants.CUSTOMRUNTIME_PROPERTIES);

		try {
			byte[] keyBytes = new byte[fis.available()];
			fis.read(keyBytes);

			// Generate the private key using the PKCS8 encoding
			KeyFactory keyFactory = KeyFactory.getInstance("RSA"); // Change to "EC" or another algorithm if needed
			PKCS8EncodedKeySpec keySpec = new PKCS8EncodedKeySpec(keyBytes);
			PrivateKey p = keyFactory.generatePrivate(keySpec);

			String data = "appticsCR-" + System.currentTimeMillis();

			// 2. Sign the data
			Signature signer = Signature.getInstance("SHA256withRSA");
			signer.initSign(p);
			signer.update(data.getBytes("UTF-8"));
			byte[] signature = signer.sign();

			// 3. Combine data and signature (data.signature)
			String combined = data + "." + Base64.getEncoder().encodeToString(signature);

			// 4. Base64-encode the combined string
			String s = Base64.getEncoder().encodeToString(combined.getBytes());

			return s;

		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception while getting Auth Key", e);
			throw new Exception("Exception while generating auth");
		} finally {
			if (!CommonUtil.isEmpty(fis)) {
				fis.close();
			}
		}
	}

