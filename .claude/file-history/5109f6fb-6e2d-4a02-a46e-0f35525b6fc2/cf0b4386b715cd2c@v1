	public static void processNativeSymboliction(CrashEntity crashentity) throws Exception {
		
		LOGGER.log(Level.INFO,"Calling ProcessNativeSymbolication Method");
		
		String issueName = AppticsConstants.UNSYMBOLICATED + " - " + crashentity.getCrashGroupString();
		String message = crashentity.getMessage();
		
		final String disabledApID =PropertyHandler.getValue(SdkConstants.DISBALEDSYMBOLICATIONAPID);
		if(disabledApID!=null && disabledApID.contains(crashentity.getApID()+"")) {
			LOGGER.log(Level.INFO, "Symbolication disabled for the apid {0}",crashentity.getApID());
			return;
		}
	
		File dsymfile = fetchFile(AppticsConstants.DSYMTABLE, crashentity);
		
		if(CommonUtil.isEmpty(dsymfile)) {
			LOGGER.log(Level.INFO,"Dsym file not there");
			String displayName = ProjectHandler.getDisplayName(crashentity.getProjectID());
			issueName = "Missing dSYMs for [" + displayName + "]";
			crashentity.setIssueName(CommonUtil.maskPII(issueName));
			crashentity.setMessage(CommonUtil.maskPII(crashentity.getMessage()));
			return;
		}

		LOGGER.log(Level.INFO,"Calling symbolication process");
		
		String crash = "";
		JSONObject crashdetails = new JSONObject();
		 
		try {
			DSymServer mac = DSymServer.getInstatnce(crashentity.getProjectID());
			String host = mac.host;
			String username = mac.username;
			String pass = mac.password;
			
			LOGGER.log(Level.INFO,"mac server is {0}",host);
			
			//Long symid = updateDsymFile(crashentity, mac);
			
			String symid = crashentity.getDeviceID() + "_" + crashentity.getHappenedAt();

			String cfile = "C_" + symid + ".crash"; 
			String symfile = "s_" + symid;

			String dsymName = crashentity.getAppVersionID() + "-" + crashentity.getAppReleaseVersion()+"_dSYM";

			String buildlocation = BUILDLOCATION + dsymName;
			String crashlocation = CRASHLOCATION + cfile;
			String desymlocation = DESYMLOCATION + symfile;
			String scriptlocation = SCRIPTLOCATION + "symbolicateHelper.sh";

			LOGGER.log(Level.INFO, "scriptlocation - {0}, crashlocation - {1}, desymlocation - {2} , buildlocation - {3}", new Object[] { scriptlocation, crashlocation, desymlocation, buildlocation });

			SshConfig config = new SshConfig(host, username, pass, cfile, CRASHLOCATION + cfile); // adding crash file
			SshExecutor.writeDataToFile(config, crashentity.getMessage());

			try {
				LOGGER.log(Level.INFO, "Checking ls in dsymlocation");
				SshExecutor.executeCommand(new SshConfig(host, username, pass, "ls " + buildlocation)); // Checking the file available status
			} catch (Exception e) {
				LOGGER.log(Level.INFO, "Exception (nofile): ", e);
				copyDSymFiletoMac(crashentity, dsymfile, crashentity.getDsymPath(), mac, buildlocation,AppticsConstants.SYMBOLICATION);

				try {
					LOGGER.log(Level.INFO, "Again_inner_ls_check");
					SshExecutor.executeCommand(new SshConfig(host, username, pass, "ls " + buildlocation)); // Checking the file available status
				} catch (Exception e1) {
					LOGGER.log(Level.INFO, "No file - Inner LS Check : ", e1);
					throw new Exception("No file at Mac Server for AppversionID "+crashentity.getAppVersionID()+", AppReleaseVersionID "+crashentity.getAppReleaseVersionID());
				}
			}

			OutputStream out = new ByteArrayOutputStream();

			SshConfig config1 = new SshConfig(host, username, pass, "sh " + scriptlocation + " " + crashlocation + " " + desymlocation + " " + buildlocation); // Desymbolicating crash command
			SshExecutor.executeCommand(config1);

			SshExecutor.writeFromFileToStream(new SshConfig(host, username, pass, cfile, desymlocation + ".json", 20), out); // writing file into stream
			SshExecutor.executeCommand(new SshConfig(host, username, pass, "rm -rvf " + crashlocation)); // removing crash file

			crash = ((ByteArrayOutputStream) out).toString();

			LOGGER.log(Level.INFO, "Crashshes {0}", crash);
			SshExecutor.executeCommand(new SshConfig(host, username, pass, "rm -rvf " + desymlocation + ".json")); // removing symbolicated file

			crashdetails = new JSONObject(crash);

				if (!CommonUtil.isEmpty(crashdetails)) {

					message = crashdetails.getString("crash");
					String crash_title = crashdetails.getString("crash_title");
					String crash_type = crashdetails.getString("crash_type");
					
