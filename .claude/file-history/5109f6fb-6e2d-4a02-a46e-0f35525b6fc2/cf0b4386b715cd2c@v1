				r.set(AppticsConstants.PID, pid);
				r.set(AppticsConstants.MESSAGE, uniqueMessage);
				r.set(AppticsConstants.SCREEN, screenname);
				r.set(AppticsConstants.MODE, mode);
				Long currentTime = System.currentTimeMillis();
				r.set(AppticsConstants.MAILSENDAT, currentTime); // NO I18N MailSentAt
				r.set(AppticsConstants.COUNT, 1); // NO I18N
				r.set(AppticsConstants.COUNTUPDATEDAT, currentTime); // NO I18N CountUpdatedAt

