	    	try {
		        String[] lines = {};
		        if (CommonUtil.isEmpty(crashentity.getBundle(), crashentity.getMessage())) {
		        	return "";
		        }
		        lines = crashentity.getMessage().split("\\n");
		        
		        String exceptionString = "Exception";
		        String causedString = "Caused by:";
		
		        switch (i) {
		            case 1:
		                String identifier = crashentity.getBundle();
		                if(lines[0].indexOf(exceptionString) == -1) {
		                	break;
		                }
		                String temp = lines[0].substring(0, lines[0].indexOf(exceptionString)+exceptionString.length());
		                
		                uniqueMessage = unique(lines, identifier);
		                if(uniqueMessage.trim().equals("") && identifier.split("\\.").length > 1) {
		                    identifier = identifier.substring(0, identifier.lastIndexOf("."));
		                    uniqueMessage = unique(lines, identifier);
		                }
		                
		                uniqueMessage = uniqueMessage != "" ? temp+" "+ uniqueMessage : uniqueMessage;
		                break;
		
		            case 2:
		                uniqueMessage = Arrays.stream(lines).filter(line -> line.startsWith(causedString)).reduce((l, l1) -> l1).orElse("");
		                if ("".equals(uniqueMessage)){
		                    break;
		                }
		                String temp1 = uniqueMessage;
		
		                StringBuilder result = new StringBuilder();
		 
		                if(uniqueMessage.indexOf(exceptionString) == -1) {
		                	result.append(uniqueMessage.substring(uniqueMessage.indexOf(causedString)+causedString.length(), uniqueMessage.indexOf(exceptionString)+exceptionString.length()));
		                }
		
		                AtomicBoolean flag = new AtomicBoolean(false);
		                Arrays.stream(lines).forEach(line -> {
		                    if(flag.get()){
		                        result.append(line);
		                        flag.set(false);
		                    }
		                    if(line.equals(temp1)){
		                        flag.set(true);
		                    }
		                });
		                
		                uniqueMessage = result.toString();
		                break;
		
		            case 3:
		            	if(lines[0].indexOf(exceptionString) != -1)
		            	{
		            		uniqueMessage = lines.length > 1 ? lines[0].substring(0, lines[0].indexOf(exceptionString)+exceptionString.length()) + " "+ lines[1] : uniqueMessage;
		            	}
		                break;
		                
		            case 4:
		            	 identifier = crashentity.getBundle();
		            	 uniqueMessage = unique(lines, identifier);
		            	 
		            	 if(!CommonUtil.isEmpty(uniqueMessage)) {
		            		 String tmpissue =crashentity.getIssueName();
		            		 
		            		 tmpissue = (tmpissue.contains("(") && tmpissue.contains(":")?tmpissue.substring(0,tmpissue.indexOf("(")):tmpissue).trim();
		            		 
		            		 uniqueMessage = tmpissue+" "+uniqueMessage;
		            	 }
		        }
		        if(uniqueMessage == "" && i <= 3) {
		            uniqueMessage = retrieveAndroidUniqueException(crashentity,i+1);
		        }
	    	}catch (Exception e) {
	    		LOGGER.log(Level.SEVERE, "Exception while fetching uniqueMessage ", e);
	    	}
	        return uniqueMessage;
	    }
	  
		private static String unique(String[] lines, String bundle){
