		SelectQuery sq = new SelectQueryImpl(Table.getTable(tableName));
		sq.addSelectColumn(Column.getColumn(tableName, pkCol));

		Criteria c = new Criteria(Column.getColumn(tableName, "Mode"), mode, QueryConstants.EQUAL);
		c = c.and(new Criteria(Column.getColumn(tableName, "Message"), uniqueMessage, QueryConstants.EQUAL));
		sq.setCriteria(c);

		Persistence p = DBHandler.getPersistence();
		DataObject dobj = null;

