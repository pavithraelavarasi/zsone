	        return uniqueMessage;
	    }

	public static void processReactReport(CrashEntity crashEntity) {

		try {
			String crashdetails[] = null;

			String message = crashEntity.getMessage();
			

			String issueName = AppticsConstants.UNSYMBOLICATED;
			// Map File Process
			LOGGER.log(Level.INFO, "Calling fetch react map file");

			String entityName = AppticsConstants.REACTANDROIDMAP;
			if (crashEntity.getPlatform().equalsIgnoreCase(AppticsConstants.IOS)) {
				entityName = AppticsConstants.REACTIOSMAP;
			}

			File symbolFile = fetchFile(AppticsConstants.REACTNATIVEFILES, crashEntity);

			File unzipFile = !CommonUtil.isEmpty(symbolFile) ? unzipFile(symbolFile, entityName) : null;

			if (!CommonUtil.isEmpty(unzipFile)) {

				String symbolicatemsg = processHybridSymbolication(crashEntity.getMessage(), unzipFile, crashEntity.getCrashType() == AppticsConstants.EXCEPTIONTYPE_FLUTTER);

				if (!CommonUtil.isEmpty(symbolicatemsg)) {
					String crash = "";

					if (symbolicatemsg.contains("stack:")) {
						symbolicatemsg = symbolicatemsg.substring(symbolicatemsg.indexOf("stack:") + 6);
					}
					crashdetails = symbolicatemsg.trim().split("\n");
					for (String crashline : crashdetails) {
						Integer index = crashline.contains("/") ? crashline.lastIndexOf("/") : 0;
						String classandline = crashline.substring(index + 1);
						crash += classandline + "\n";
					}
					crashdetails = crash.split("\n");

					if (crashdetails[0].contains(":") ? !crashdetails[0].split(":")[0].equals("null") : true) {
						message = crashEntity.getIssueName() + "\n" + crash;
						issueName = crashdetails[0];
					}
				}
			}
			crashEntity.setMessage(CommonUtil.maskPII(message));
			crashEntity.setIssueName(CommonUtil.maskPII(issueName));
			

		} catch (Exception e) {
			LOGGER.log(Level.INFO, "Exception While processing ReactNative Crash");
		}

	}
	
