	private static Long setUniqueID(CrashEntity crashEntity) throws Exception{
        Map<Long, Boolean> isUniqueMap = new LinkedHashMap<Long, Boolean>(); 
        Long uniqueId;
		
		if (crashEntity.getExceptionGroup().equalsIgnoreCase(AppticsConstants.FATAL)) {
			 isUniqueMap = SDKCache.getInstance().getFatalExpUniqueID(crashEntity);
			 uniqueId=  isUniqueMap.keySet().iterator().next();
		} else if (crashEntity.getExceptionGroup().equalsIgnoreCase(AppticsConstants.NONFATAL)) {
			 //isUniqueMap = SDKCache.getInstance().getNonFatalExpUniqueID(crashEntity);
			 //uniqueId=  isUniqueMap.keySet().iterator().next();
			 uniqueId = 0l;
		} else if (crashEntity.getExceptionGroup().equalsIgnoreCase(AppticsConstants.ANR)) {
			 isUniqueMap = SDKCache.getInstance().getAnrExpUniqueID(crashEntity);
			 uniqueId=  isUniqueMap.keySet().iterator().next();
		}
		else { //Getting webError
			isUniqueMap = SDKCache.getInstance().getErrorExpUniqueID(crashEntity);
